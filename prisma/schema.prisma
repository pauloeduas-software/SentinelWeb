generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A máquina descoberta pelo Agente Sentinel — o lado RMM.
//
// Chamava-se `Asset` até a Fase 1. O nome foi liberado para o ativo do ITAM, que
// é o `Asset` do vocabulário do Snipe-IT. Aqui nenhuma coluna pode voltar a se
// chamar `status`, `lastSeen` ou `hwid` do outro lado: é essa ausência que faz o
// compilador barrar uma query do RMM que aponte para a tabela errada
// (docs/historico/fase-01-catalogo-e-ativo.md, D13).
model Endpoint {
  id       String @id @default(uuid()) @db.Uuid
  hwid     String @unique
  hostname String

  osVersion String

  // O EIXO DO AGENTE, e só ele. Enum desde a F7: era `String` livre, e o que
  // impedia `status = "Em uso"` de entrar aqui era a boa vontade de quem
  // escrevesse a query. O ciclo de vida do ativo é `StatusLabel`, outra tabela,
  // outro eixo (docs/historico/fase-07-convergencia-rmm-itam.md, D98).
  //
  // DOIS VALORES, e não os três que chegaram a ser propostos: `NEVER_SEEN` seria um valor
  // que NENHUMA linha desta tabela pode ter, porque a linha nasce de um
  // handshake. "Cadastrado e nunca visto" é pergunta do ATIVO, e quem responde é
  // `Asset.lastSeenByAgentAt` no painel de cobertura.
  status   AgentStatus @default(ONLINE)
  lastSeen DateTime    @default(now())

  cpuModel   String?
  localIp    String?
  macAddress String?

  // ── IDENTIDADE COLETADA (F7, Etapa A) ────────────────────────────────────
  // Tudo nulável: o agente vive fora deste repositório e o rollout leva
  // semanas. Máquina que não manda serial não pontua por serial — não vira erro.
  biosSerial    String?
  systemUuid    String?
  manufacturer  String?
  /// `hardwareModel`, nunca `model`: `endpoint.model` lê-se como a relação de
  /// catálogo do ativo, e o compilador não pegaria a confusão (D13).
  hardwareModel String?
  chassisType   String?

  // SPECS COLETADAS — e elas moram AQUI, não em `assets`.
  //
  // Pedia-se "specs de hardware como atributo do ativo". O que se queria de
  // verdade era que o dado parasse de sumir no expurgo da telemetria,
  // e coluna nesta tabela resolve isso. Copiá-las para `assets` criaria uma
  // segunda fonte de verdade sobre a MESMA máquina, com um detalhe que a torna
  // pior que as outras: as duas podem divergir com razão (o pente foi trocado) e
  // ninguém saberia qual está certa. É o D16 uma camada abaixo.
  ramTotalBytes  BigInt?
  diskTotalBytes BigInt?

  /// Triagem do Shadow IT: máquina vista pelo agente e sem cadastro.
  reviewState ReviewState @default(UNREVIEWED)

  // ── O VÍNCULO COM O PATRIMÔNIO (D45) ─────────────────────────────────────
  //
  // A FK mora AQUI, e não em `assets`, por duas razões. A maioria dos ativos
  // nunca terá agente (monitor, cadeira, cabo, switch): no outro lado a coluna
  // ficaria nula na esmagadora maioria das linhas. E este é o lado que a
  // reconciliação ESCREVE.
  //
  // `@unique` garante o 1:1 sem tabela de junção. `SetNull` garante que apagar
  // um ativo não leve junto a telemetria da máquina — mas note que ele desfaz o
  // vínculo EM SILÊNCIO, e é por isso que o `desvincularEndpoint` tem linha no AuditLog.
  assetId String? @unique @db.Uuid
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  telemetries Telemetry[]
  suggestions ReconciliationSuggestion[] @relation("SugestaoDoEndpoint")

  @@index([reviewState])
  @@map("endpoints")
}

// O eixo do AGENTE. Ver a nota em `Endpoint.status` para por que são dois
// valores e não três (D98).
enum AgentStatus {
  ONLINE
  OFFLINE
}

// A triagem do Shadow IT: máquina que o agente vê e o cadastro não conhece.
// `UNREVIEWED` é o estado de quem acabou de aparecer — a fila de trabalho.
enum ReviewState {
  UNREVIEWED
  ALLOWED
  BLOCKED
}

model Telemetry {
  id           String   @id @default(uuid()) @db.Uuid
  endpointId   String   @db.Uuid
  cpuUsage     Float
  ramTotal     BigInt
  ramUsed      BigInt
  timestamp    DateTime @default(now())
  disks        Json?
  network      Json?
  topProcesses Json?
  endpoint     Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  /// As duas perguntas que se fazem a esta tabela fixam a máquina e ordenam pelo
  /// tempo: a amostra ATUAL de uma máquina (a ficha do ativo e a do posto, de
  /// poucos em poucos segundos) e a JANELA de três dias do agregado de uso, que
  /// é o único leitor da série histórica. Sem este índice as duas eram varredura
  /// sequencial da tabela inteira — ver a migration que o criou.
  @@index([endpointId, timestamp(sort: Desc)])
  // O expurgo diário (`purge-telemetry.usecase.ts`) apaga por faixa de
  // data; sem este índice, cada rodada varreria a tabela inteira.
  @@index([timestamp])
  @@map("telemetries")
}

/// Os cargos da autorização (D148). Hoje um só, `ADMIN` (Z): a separação de
/// cargos é decisão a tomar. A ordem do enum é a hierarquia, e a comparação mora
/// em `access/helpers/cargo.ts` — nunca num `indexOf` por fora.
enum Cargo {
  ADMIN
}

// QUEM OPERA O SISTEMA — hoje, só Administrador (Z).
//
// Quem RECEBE equipamento é outra tabela (`Person`): conta de acesso e pessoa
// que tem posse são perguntas diferentes, e misturá-las obrigava o login a
// recusar o cargo que só existia para dizer "esse não entra".

model User {
  id    String @id @default(uuid()) @db.Uuid
  name  String
  // É o LOGIN: quem entra no sistema digita o e-mail e a senha. `@unique`
  // comum, sem índice parcial: usuário não tem lixeira — excluir apaga a linha
  // (W) —, então não há linha apagada segurando o e-mail de ninguém.
  email String @unique

  // AUTENTICAÇÃO (F3). Obrigatória: todo usuário entra no painel.
  passwordHash String

  // Bloqueio por tentativa. `lockedUntil` no futuro recusa o login mesmo com a
  // senha certa; quem zera os dois é o login bem-sucedido.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // A GERAÇÃO DA SESSÃO — o que faz trocar a senha DERRUBAR quem já está dentro.
  //
  // O buraco que isto fecha: a releitura por requisição
  // (`current-user.usecase.ts`) mata a sessão de quem foi apagado ou desativado,
  // mas NÃO a de quem continua sendo um usuário válido. Então quem roubasse o
  // cookie seguia operando por até 8 horas mesmo DEPOIS de a vítima trocar a
  // senha — que é justamente o que a vítima faz ao desconfiar.
  //
  // O número vai assinado dentro do JWT e é conferido contra esta coluna a cada
  // requisição: incrementar aqui invalida, de uma vez, todo token emitido antes
  // — sem tabela de sessão e sem lista de revogação.
  tokenVersion Int @default(0)

  // Desativar é diferente de excluir: a conta continua na lista e volta com
  // Ativar, só não entra mais no sistema. Editável em `PUT /api/users/:id`.
  isActive Boolean @default(true)

  // O CARGO (D148), no lugar da matriz de permissões por grupo (D76).
  //
  // `ADMIN` é o padrão porque é o único (Z). A rede que impede o sistema de
  // ficar sem ninguém que entre está em `access/helpers/ultimo-administrador.ts`,
  // chamada no fim da transação.
  role      Cargo    @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// O COLABORADOR — quem RECEBE equipamento. Não entra no sistema.
//
// Uma tabela de catálogo (a sexta aba de Configurações) e a ÚNICA dele com
// lixeira: o colaborador tem histórico de posse PRÓPRIO — "o que já esteve com a
// Laura" —, e recadastrá-lo depois de excluir o partiria em dois. Excluir manda
// para a lixeira, e só recusa quem responde por algo AGORA (invariante 6).
model Person {
  id   String @id @default(uuid()) @db.Uuid
  name String

  // Opcional: o colaborador não faz login, e há quem não tenha e-mail. NÃO é
  // @unique aqui: a unicidade é índice PARCIAL (`WHERE "deletedAt" IS NULL`) na
  // migration, para o excluído não travar o recadastro do mesmo e-mail. Dois
  // `NULL` não colidem; gravado em minúsculas.
  email String?

  // DESATIVAR é o caminho de quem não pode excluir: quem saiu da empresa
  // continua no histórico de posse, só não recebe entrega nova. Só desativa
  // quem não responde por nada (invariante 6, `personSpec.beforeWrite`).
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Posses diretas (alvo PERSON) e postos de trabalho que esta pessoa ocupa.
  // Responsabilidade real = as duas somadas (docs/referencia/modelo-de-posse.md, Camada 3).
  assignments Assignment[]
  occupancies WorkstationOccupant[]

  // LICENÇA. Entregue a uma pessoa ou a um ativo, nunca a um posto (D39, AA).
  licenseCheckouts LicenseCheckout[]

  // ─────────────────────────────────────────────────────────────────────────
  // A PERGUNTA QUE PASSA POR UMA PESSOA (D72).
  //
  //   quem RESPONDE pelo ativo?    a posse aberta → pessoa, ou os ocupantes do
  //                                 posto (`resolverResponsaveis`)
  //
  // Em uma linha: *o posto responde pelo ativo, e a pessoa responde pelo posto.*
  // Não há "gestor do espaço": a localização não aponta para pessoa nenhuma.
  // ─────────────────────────────────────────────────────────────────────────
  //
  // As unidades de estoque entregues NO NOME desta pessoa (`StockMovement`
  // de alvo PERSON): é a ponta do estoque na invariante 6.
  stockMovements StockMovement[]

  @@index([deletedAt])
  @@map("people")
}

// Quem fez uma linha da auditoria: uma conta do painel, ou o próprio sistema
// (um job, um comando de terminal). É a separação que a auditoria existe para
// provar — "foi o sistema" e "foi a conta X" são respostas diferentes (AB).
enum AuditActorType {
  USER
  SYSTEM
  ANONYMOUS
}

// A AUDITORIA — quem fez o quê, em qual registro, e quando (AB).
//
// O AUTOR fica só no banco: tela nenhuma o mostra — as abas de histórico do
// ativo e do colaborador leem o que mudou, nunca quem. Ele existe para o
// administrador responder, com o banco na mão, se um erro foi do sistema ou de
// uma conta.
//
// SEM FK NENHUMA, de propósito: excluir o ativo, a licença ou a conta não pode
// levar junto a linha que diz quem os excluiu. Por isso o autor e o registro vão
// POR ESCRITO (`actorName`, `actorEmail`, `entityLabel`) — o id de algo que foi
// apagado não leva a ninguém. O `actorId` fica só para desempatar um e-mail
// reaproveitado depois de uma exclusão.
//
// A coerência do autor é CHECK (`audit_logs_autor_coerente`, e
// `audit_logs_registro_por_escrito` para o texto em branco), e a linha não se
// altera nem se apaga: um trigger recusa `UPDATE` e `DELETE`
// (`audit_logs_imutavel`). Estão escritos à mão na migration.
model AuditLog {
  id          String  @id @default(uuid()) @db.Uuid
  entityType  String
  /// Nulo na configuração da descoberta e na rodada de reconciliação.
  entityId    String? @db.Uuid
  /// O registro por escrito: a etiqueta do ativo, o nome do item, do posto.
  entityLabel String
  action      String
  changes     Json?

  actorType  AuditActorType
  /// Nulos no SYSTEM, com o `requestId`: o sistema não é uma conta. No
  /// ANONYMOUS (o login sem sessão) só o `requestId` fica.
  actorId    String?        @db.Uuid
  actorName  String?
  actorEmail String?
  /// De onde veio: 'painel', 'job:reconciliacao', 'cli:conceder-administrador:<usuário do SO>'.
  source     String
  /// O `X-Request-Id` da requisição — o mesmo do log do servidor. Nulo no SYSTEM.
  requestId  String?

  createdAt DateTime @default(now())

  // Um por pergunta de `prisma/verificacoes/auditoria.sql`: o registro (pelo
  // id, que segue o registro renomeado), a conta (pelo e-mail e pelo id, que
  // segue a troca de e-mail), o nome, a requisição e os últimos dias.
  @@index([entityId, createdAt])
  @@index([actorEmail, createdAt])
  @@index([actorId, createdAt])
  @@index([entityLabel])
  @@index([requestId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// CATÁLOGO — as tabelas que o Snipe-IT chama de *Settings* (docs/historico/fase-01-catalogo-e-ativo.md)
//
// Nenhuma tem `deletedAt`, e isso é decisão, não esquecimento (D8): a extension
// de soft delete descobre a lixeira pela PRESENÇA da coluna, então a ausência é
// o opt-out. A proteção aqui é o 409 por uso — que é o que o Snipe-IT realmente
// faz ao recusar apagar categoria com item associado. Manter lixeira no catálogo
// custaria um índice único parcial por tabela, o `upsert` do seed e uma camada de
// apresentação para esconder relação apagada (a extension não alcança leitura
// aninhada — verificado).
// ============================================================================

// A que MÓDULO a categoria pertence. `STOCK` é o item por quantidade — monitor,
// teclado, mouse, cabo —, sem patrimônio individual: o que não é máquina não é
// ativo (ver `StockItem`).
enum CategoryType {
  ASSET
  LICENSE
  STOCK
}

// O tipo do status responde: *o que dá para fazer com este ativo agora?*
//
//   DEPLOYABLE   — está no estoque e pode ser entregue. O único que libera o
//                  checkout da F4.
//   IN_USE       — está com alguém ou instalado em algum lugar. Fora do estoque
//                  porque está CUMPRINDO a função dele.
//   PENDING      — fora do estoque por algum impedimento, e volta: em reparo,
//                  em diagnóstico, em trânsito, à espera de preparo.
//   UNDEPLOYABLE — ainda é patrimônio seu, mas não serve mais e não volta:
//                  danificado sem conserto, perdido, roubado.
//
// Não existe tipo "arquivado": o ativo que sai de vez (vendido, descartado,
// doado) é BAIXADO — `retiredAt` + `retiredReason` no `Asset`.
//
// `IN_USE` é tipo PRÓPRIO, e não `PENDING`, porque a diferença entre "está com
// um colaborador" e "está na assistência" é a distinção mais cara do inventário:
// um está gerando valor, o outro está custando. Empacotar os dois em `PENDING`
// torna "quantos ativos estão em uso?" — a métrica principal do módulo —
// inexpressável pelo tipo.
//
// Também não é derivado da posse: `statusId` é obrigatório no cadastro,
// a carga inicial é feita de equipamento que já está com gente, e existe uso SEM
// responsável (o monitor parafusado na sala de reunião).
//
// A ordem dos valores é a do ciclo de vida, e o Postgres a usa em `ORDER BY`
// sobre a coluna — por isso `IN_USE` entra DEPOIS de `DEPLOYABLE` na migration,
// e não no fim.
enum StatusLabelType {
  DEPLOYABLE
  IN_USE
  PENDING
  UNDEPLOYABLE
}

// Por que o ativo saiu do patrimônio. Fechado de propósito: é campo de
// relatório contábil, e texto livre aqui vira "vendido", "Vendido" e "venda"
// na mesma coluna (D5).
enum RetiredReason {
  VENDIDO
  DESCARTADO
  DOADO
  EXTRAVIADO
  ROUBADO
  GARANTIA
}

model Category {
  id   String       @id @default(uuid()) @db.Uuid
  name String
  type CategoryType

  // Desativado some das listas de escolha e não é escolhido de novo; o que já
  // aponta para ele continua (docs/referencia/configuracoes.md). É a saída de
  // quem não pode ser excluído por ter uso.
  isActive Boolean @default(true)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assetModels AssetModel[]

  licenses   License[]
  stockItems StockItem[]

  // Por (nome, tipo), não só por nome: "Notebook" como categoria de ATIVO e
  // "Notebook" como categoria de LICENÇA são duas coisas diferentes.
  @@unique([name, type])
  @@map("categories")
}

model StatusLabel {
  id   String          @id @default(uuid()) @db.Uuid
  name String          @unique
  type StatusLabelType

  notes String?

  // Desativado some das listas de escolha e não é escolhido de novo; o que já
  // aponta para ele continua (docs/referencia/configuracoes.md). É a saída de
  // quem não pode ser excluído por ter uso.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]

  @@map("status_labels")
}

model Manufacturer {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  url          String?
  supportPhone String?
  supportEmail String?

  // Desativado some das listas de escolha e não é escolhido de novo; o que já
  // aponta para ele continua (docs/referencia/configuracoes.md). É a saída de
  // quem não pode ser excluído por ter uso.
  isActive Boolean @default(true)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assetModels AssetModel[]

  licenses License[]

  @@map("manufacturers")
}

model AssetModel {
  id   String @id @default(uuid()) @db.Uuid
  name String

  modelNumber String?
  notes       String?

  // Desativado some das listas de escolha e não é escolhido de novo; o que já
  // aponta para ele continua (docs/referencia/configuracoes.md). É a saída de
  // quem não pode ser excluído por ter uso.
  isActive Boolean @default(true)

  manufacturerId String @db.Uuid
  categoryId     String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict é a rede embaixo do 409 do `countUsages`: mesmo que a checagem da
  // aplicação seja esquecida, o banco recusa e o P2003 vira 409 no errorHandler.
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  assets Asset[]

  // Vários modelos SEM número convivem: o Postgres trata NULL como distinto,
  // então não é preciso índice parcial aqui (verificado).
  @@unique([manufacturerId, modelNumber])
  @@index([categoryId])
  @@map("asset_models")
}

model Location {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  // LISTA PLANA, sem hierarquia e sem gestor: a matriz, a filial, o depósito,
  // o home office. Uma árvore matriz › andar › sala não diferenciava nada —
  // só custava guarda de ciclo e trava da árvore. Saiu inteira, e o "gestor da
  // localidade" com ela.
  address String?
  city    String?
  state   String?
  zip     String?
  phone   String?
  notes   String?

  // Cadastro de REFERÊNCIA, como status e categoria: diz ONDE a coisa está
  // guardada e não recebe nada — quem recebe entrega, estoque e ocupante é o
  // POSTO (`Workstation`, decisão Y).
  //
  // DESATIVAR tira o local das escolhas sem excluí-lo. Excluir só é recusado
  // (409) pelo que está nele AGORA: ativo ou item de estoque guardado, posto
  // que fica nele. Desativada, ela não recebe ativo, item ou posto novo; o que
  // já está lá fica.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets       Asset[]
  // Os itens de estoque GUARDADOS aqui (não os entregues — esses são as saídas).
  stockItems   StockItem[]
  workstations Workstation[]

  @@map("locations")
}

// POSTO DE TRABALHO — a MesaEscritório, a bancada, o guichê (decisão Y).
//
// Cadastro próprio, e não uma `Location` marcada: o lugar diz onde a coisa está
// guardada, o posto RECEBE — o computador (`Assignment`), o estoque entregue à
// mesa (`StockMovement`) e as pessoas que o ocupam (`WorkstationOccupant`).
// Misturados numa tabela só, o depósito recebia entrega como se fosse mesa.
//
// O posto FICA numa localização (`locationId`, obrigatória), e é só isso que
// os liga: o ativo continua com UM campo de "onde" (`Asset.locationId`).
//
// A regra de cadastro é a do status: nome único, desativar em vez de excluir,
// e a exclusão recusada só pelo que está nele AGORA — entrega ou saída aberta,
// ocupante atual (`workstationSpec`). O passado não segura: as linhas já
// fechadas guardam o nome por escrito.
//
// No máximo UM ativo por posto — ativo é computador (invariante 19). O estoque
// entregue à mesa entra sem limite, e os ocupantes são vários por desenho (a
// Camada 2 do modelo de posse).
model Workstation {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  locationId String  @db.Uuid
  notes      String?

  // Desativado some das escolhas e não RECEBE nada novo: entrega de ativo ou
  // de estoque, ocupante. O que já está nele fica — desativar não devolve nem
  // encerra nada, igual ao colaborador desativado.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict: a localização com posto é "em uso" e se desativa, não se exclui.
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  // Ativos entregues A ESTE POSTO e as pessoas que o ocupam. É a junção das
  // duas que responde "quem é responsável pelo computador da Mesa 1". E as
  // unidades de ESTOQUE entregues à mesa — os 5 mouses da Mesa 1 —, pelas
  // quais respondem os mesmos ocupantes.
  assignments    Assignment[]
  occupants      WorkstationOccupant[]
  stockMovements StockMovement[]

  @@index([locationId])
  @@map("workstations")
}

// ============================================================================
// O ATIVO — o coração do ITAM (docs/historico/fase-01-catalogo-e-ativo.md, Etapa G)
// ============================================================================

// Um ativo = UM equipamento físico, com etiqueta e série próprias.
//
// Não existe `quantity` aqui, e é de propósito (D3): um ativo é UM equipamento.
// Contagem é consulta sobre linhas, não coluna.
//
// NÃO há `categoryId`: a categoria do ativo é a do MODELO (`model.category`) —
// é assim no Snipe-IT, e é o que impede um ativo e o seu modelo divergirem de
// categoria. Por isso `modelId` é obrigatório.
//
// NENHUMA coluna aqui pode se chamar `status`, `lastSeen` ou `hwid`: são os
// nomes do `Endpoint` (lado RMM), e é a ausência deles que faz o compilador
// barrar uma query do RMM que aponte para esta tabela (D13). O último contato
// do agente, que a F7 passou a registrar, se chama `lastSeenByAgentAt`.
model Asset {
  id String @id @default(uuid()) @db.Uuid

  // Unicidade de `assetTag` e `serial` é índice PARCIAL (`WHERE "deletedAt" IS
  // NULL`), criado à mão na migration — NÃO `@unique`. Com unique comum, um
  // ativo na lixeira travaria para sempre o recadastro da mesma etiqueta. É o
  // `unique_undeleted` do Snipe-IT, o mesmo caso de `User.email` na Fase 0.
  assetTag String
  serial   String?

  name  String?
  notes String?

  statusId   String  @db.Uuid
  modelId    String  @db.Uuid
  // ONDE o ativo está. NÃO é quem responde por ele — quem responde é a
  // `Assignment` aberta (docs/referencia/modelo-de-posse.md): um ativo pode estar
  // EM um lugar sem ser DO lugar.
  locationId String? @db.Uuid

  orderNumber  String?
  purchaseDate DateTime?
  // Decimal, nunca Float. Sai no JSON como string.
  purchaseCost Decimal?  @db.Decimal(12, 2)

  // BAIXA — o ativo saiu do parque, e por quê.
  //
  // São DUAS colunas diferentes e uma não substitui a outra (D19):
  //   `retiredAt` — saiu do PATRIMÔNIO: vendido, descartado, roubado
  //   `deletedAt` — foi cadastrado errado e está na lixeira
  // Um ativo vendido é um fato contábil e continua nos relatórios; um ativo na
  // lixeira é um erro de digitação e não deveria ter existido.
  retiredAt     DateTime?
  retiredReason RetiredReason?
  // A observação da baixa, enquanto ela vale: a aba Detalhes a mostra ao lado
  // do motivo, e desfazer a baixa a limpa junto. A de cada baixa passada fica na
  // auditoria (AB), que a tela não lê.
  retiredNotes  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  status   StatusLabel @relation(fields: [statusId], references: [id], onDelete: Restrict)
  model    AssetModel  @relation(fields: [modelId], references: [id], onDelete: Restrict)
  // Restrict, como o status: a localização com ativo guardado — lixeira
  // inclusive — é "em uso" e se desativa, não se exclui (`locationSpec`).
  location Location?   @relation(fields: [locationId], references: [id], onDelete: Restrict)

  // A posse deste ativo, aberta e histórica.
  assignments Assignment[] @relation("AssignmentAsset")

  // As licenças entregues a esta máquina (AA).
  licenseCheckouts LicenseCheckout[]

  // ── A CONVERGÊNCIA COM O RMM (F7) ────────────────────────────────────────
  //
  // `lastSeenByAgentAt`, e NUNCA `lastSeen` (D13). Se esta coluna se chamasse
  // `lastSeen`, o `markStaleEndpointsOffline` apontando para o model errado
  // COMPILARIA — e marcaria a frota inteira como OFFLINE em silêncio. Com o nome
  // diferente, o mesmo erro vira erro de compilação.
  //
  // QUEM ESCREVE É O JOB, não o handshake (D95). O `touchEndpoint` roda a cada
  // mensagem de cada máquina; um UPDATE condicional em `assets` ali seria
  // executado milhões de vezes por dia para quase nunca casar, e acoplaria a
  // tabela de patrimônio ao caminho de ingestão. A pergunta que esta coluna
  // responde — "não é visto há quantos dias?" — tolera uma hora de atraso.
  //
  // E ela EXISTE, em vez de ser derivada pelo `Endpoint`, porque a linha da
  // máquina descoberta pode sumir — apagá-la não pode zerar o histórico de "um
  // agente já viu este ativo".
  lastSeenByAgentAt DateTime?

  /// A máquina descoberta que É este ativo. Lado fraco do 1:1 — a FK mora lá (D45).
  endpoint Endpoint?

  changes   AssetChange[]
  usageDays AssetUsageDaily[]

  // `suggestions`, e não o `ReconciliationSuggestion` que o `prisma format`
  // escreveu sozinho: o nome gerado não é convenção nenhuma e destoa do outro
  // lado da relação (`Endpoint` a chama de `suggestions`). Nome de campo de
  // relação não existe no banco, então isto
  // NÃO pede migração — o que ele muda é o que se lê no `include`.
  suggestions ReconciliationSuggestion[]

  @@index([deletedAt])
  @@index([statusId])
  @@index([modelId])
  @@index([locationId])
  // DECLARADO AQUI, e não só na migration que o criou: nasceu à mão e, fora do
  // schema, o `migrate diff` o tomava por lixo e emitia `DROP INDEX` dele a
  // cada migração nova. Índice COMUM o Prisma expressa; só os PARCIAIS
  // (`WHERE …`) moram de propósito só no SQL.
  @@index([retiredAt])
  @@index([lastSeenByAgentAt])
  @@map("assets")
}

// ============================================================================
// POSSE E RESPONSABILIDADE — docs/referencia/modelo-de-posse.md (D14, D15, D16)
// ============================================================================

// Para QUEM um ativo foi entregue.
//
// Polimórfico — pessoa ou posto —, com uma diferença que o Snipe-IT não tem:
// quando o alvo é `WORKSTATION`, os responsáveis são os OCUPANTES daquele posto,
// que podem ser vários e em turnos diferentes (`WorkstationOccupant`). É o que
// permite a Mesa 1 ser da Laura de manhã e da Ana à tarde sem o ativo precisar
// apontar para duas pessoas.
//
// Localização NÃO é alvo: ela diz onde a coisa está guardada, não quem a
// recebeu (decisão Y).
//
// Não há alvo ATIVO: ativo é computador, e um computador não é entregue a outro
// computador. O que acompanha a máquina (dock, monitor, cabo) é estoque.
enum AssignmentTarget {
  PERSON
  WORKSTATION
}

// Uma linha por entrega. `checkinAt` nulo = posse ABERTA (a atual).
//
// O histórico NUNCA é apagado: a devolução preenche `checkinAt`, não deleta a
// linha. É o mesmo princípio do `AuditLog`.
//
// UMA aberta por ativo, garantida por índice único PARCIAL criado na migration
// (`WHERE "checkinAt" IS NULL`) — regra do banco, não da aplicação, pelo mesmo
// motivo de `assets.assetTag`: o esquecimento deixa de ser possível.
//
// Esse índice é também a alavanca da decisão: o dia que N detentores simultâneos
// for necessário, derrubar o índice é a mudança — não reescrever a camada.
model Assignment {
  id      String @id @default(uuid()) @db.Uuid
  assetId String @db.Uuid

  // Discriminante + duas FKs nuláveis. A coerência entre o tipo e qual FK está
  // preenchida é validada no use-case (`assertAlvoCoerente`) e pelo CHECK
  // `assignments_alvo_coerente`, escrito à mão na migration: CHECK constraint
  // não é expressável no schema do Prisma e ficaria invisível aqui.
  targetType          AssignmentTarget
  targetPersonId      String?          @db.Uuid
  targetWorkstationId String?          @db.Uuid

  // O NOME DO POSTO, por escrito — preenchido quando o posto é excluído.
  //
  // Posto segue a regra do status: só o que está nele agora impede excluí-lo.
  // A posse já devolvida perde a ligação (`targetWorkstationId` vira nulo) e
  // guarda aqui o nome que o posto tinha, para o histórico do ativo continuar
  // dizendo "Entregue: Mesa 7" (`workstationSpec.beforeDelete`).
  targetWorkstationName String?

  checkoutAt        DateTime  @default(now())
  expectedCheckinAt DateTime?
  checkinAt         DateTime?

  checkoutNotes String?
  checkinNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade no ativo dono da posse: apagar o ativo de verdade leva o histórico
  // dele junto. Restrict nos ALVOS: é a rede embaixo do 409 por uso. A exclusão
  // do posto desliga ANTES as posses já devolvidas (`targetWorkstationName`),
  // então o que a FK ainda pega é a posse aberta — e essa o 409 já recusou.
  asset             Asset        @relation("AssignmentAsset", fields: [assetId], references: [id], onDelete: Cascade)
  targetPerson      Person?      @relation(fields: [targetPersonId], references: [id], onDelete: Restrict)
  targetWorkstation Workstation? @relation(fields: [targetWorkstationId], references: [id], onDelete: Restrict)

  @@index([assetId, checkinAt])
  @@index([targetPersonId, checkinAt])
  @@index([targetWorkstationId, checkinAt])
  @@map("assignments")
}

model WorkstationOccupant {
  id            String  @id @default(uuid()) @db.Uuid
  // Nulo só na ocupação ENCERRADA de um posto que foi excluído — o nome dele
  // fica em `workstationName`, pelo mesmo motivo da `Assignment`. Aberta, aponta
  // sempre para o posto (CHECK `workstation_occupants_posto_presente`).
  workstationId String? @db.Uuid
  personId      String  @db.Uuid

  /// O nome do posto, por escrito, quando ele foi excluído.
  workstationName String?

  // Texto livre de propósito: "Manhã", "Tarde", "12x36 A". Enum engessaria
  // escalas reais e faixa de horário seria agenda, não inventário (D15).
  shift String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict, não Cascade: quem ocupou a Mesa 1 e em que turno é histórico de
  // responsabilidade, e apagar o posto não pode apagá-lo junto. Com ocupante
  // AGORA, o posto não se exclui; as ocupações encerradas são desligadas antes,
  // com o nome em `workstationName` (`workstationSpec.beforeDelete`).
  workstation Workstation? @relation(fields: [workstationId], references: [id], onDelete: Restrict)
  person      Person       @relation(fields: [personId], references: [id], onDelete: Restrict)

  // A mesma pessoa não ocupa o mesmo posto duas vezes ao mesmo tempo: índice
  // único PARCIAL (`WHERE "endedAt" IS NULL`) criado na migration.
  @@index([workstationId, endedAt])
  @@index([personId, endedAt])
  @@map("workstation_occupants")
}

model JobRun {
  /// O nome do job — 'reconciliacao' (de hora em hora) e 'expurgo-da-telemetria' (diário).
  name      String    @id
  lastRunAt DateTime?
  updatedAt DateTime  @updatedAt

  @@map("job_runs")
}

model AppSetting {
  id String @id @default("singleton")

  // Etiqueta automática: ATV- + 00001. `assetTagNext` é incrementado PRIMEIRO e
  // o valor devolvido é o que vira etiqueta — ler-e-depois-incrementar colide
  // em READ COMMITTED.
  assetTagPrefix   String @default("ATV-")
  assetTagZerofill Int    @default(5)
  assetTagNext     Int    @default(1)

  // ── OS BOTÕES DA DESCOBERTA (F7) ─────────────────────────────────────────
  //
  // Moram no singleton que já existe, e não numa tabela de configuração nova:
  // são três valores, não um domínio.
  //
  // `SUGGEST` é o padrão e isso é o D51: em `ON`, a varredura vincula sozinha
  // a máquina ao ativo quando há um único candidato de 100 pontos, sem ninguém
  // conferir — e um vínculo errado põe o último contato e o uso da máquina no
  // ativo errado até alguém desvincular.
  discoveryMode DiscoveryMode @default(SUGGEST)

  /// Ativo sem contato de agente há mais que isto é FANTASMA.
  ghostDays   Int @default(30)
  /// Máquina sem cadastro vista há mais que isto é SHADOW IT.
  shadowHours Int @default(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ============================================================================
// LICENÇAS DE SOFTWARE — docs/decisoes/licencas.md (D39–D94, AA, AC)
//
// A licença é o contrato com a QUANTIDADE comprada; cada uso é uma linha de
// entrega (AA). Não há vaga numerada: livres é conta sobre as entregas
// (compradas − em uso), e o status é função das datas e de hoje
// (D44). Entrega vai para uma pessoa XOR um ativo, nunca para um posto (D39).
// ============================================================================

model License {
  // SEM `@default(uuid())`: o id vem da aplicação (create-license.usecase.ts).
  id   String @id @db.Uuid
  /// Pode repetir: a renovação convive com o contrato encerrado de mesmo nome (AA).
  name String

  /// Quantas licenças o contrato comprou, ao menos uma (CHECK
  /// `licenses_seats_positivo`). Em uso nunca passa disto (invariante 22,
  /// garantida sob a trava da licença).
  seatsTotal Int

  expirationDate  DateTime?
  /// Encerramento. Vence tudo: chegado o dia, a licença é ENCERRADA mesmo com
  /// vencimento futuro, e sai da lista para a aba Encerradas
  /// (`license-status.helper.ts` compara com o dia de hoje em Brasília).
  terminationDate DateTime?

  licensedToName  String?
  licensedToEmail String?

  categoryId     String  @db.Uuid
  manufacturerId String? @db.Uuid

  orderNumber  String?
  /// O vencimento e o encerramento não antecedem esta data, quando as duas
  /// estão preenchidas (CHECKs `licenses_*_nao_antecede_compra`).
  purchaseDate DateTime?
  /// Decimal, nunca Float. Sai no JSON como STRING.
  purchaseCost Decimal?  @db.Decimal(12, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)

  /// As chaves compradas (AC): a de volume, ou uma por licença.
  keys      LicenseKey[]
  checkouts LicenseCheckout[]

  @@index([categoryId])
  // O `countUsages` do fabricante e o `Restrict` no delete dele varrem esta
  // coluna; sem índice, cada exclusão de fabricante lê a tabela inteira.
  @@index([manufacturerId])
  @@index([expirationDate])
  @@index([terminationDate])
  @@map("licenses")
}

// Uma chave de produto do contrato (AC). Cobre `seats` licenças: 1 na chave
// individual, mais na de volume. As chaves de uma licença cobrem no máximo o que
// foi comprado, e nenhuma vai para mais entregas abertas do que cobre
// (invariante 24, sob a trava da licença). Em texto: a cifra saiu na G. Só o
// detalhe a devolve, e a tela a mostra escondida até alguém pedir.
model LicenseKey {
  id String @id @default(uuid()) @db.Uuid

  licenseId String @db.Uuid

  /// Uma linha, única na licença.
  productKey String
  /// Quantas licenças esta chave cobre, ao menos uma (CHECK `license_keys_seats_positivo`).
  seats      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade: a chave é parte do contrato. Só a licença nunca entregue se exclui
  // (AA), e a chave já entregue segura a sua pelo `Restrict` de `license_checkouts`.
  license   License           @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  checkouts LicenseCheckout[]

  @@unique([licenseId, productKey])
  // O alvo da FK composta de `license_checkouts`: a entrega só aponta para uma
  // chave DA PRÓPRIA licença.
  @@unique([id, licenseId])
  @@map("license_keys")
}

// Uma linha por entrega. Devolver preenche `checkinAt` e NUNCA apaga a linha —
// é dela que saem as contas e o histórico da licença, do ativo e da pessoa (AA).
model LicenseCheckout {
  id String @id @default(uuid()) @db.Uuid

  // Sempre aponta para a licença: a licença que já foi entregue não se exclui
  // (AA), e a FK `Restrict` é a rede.
  licenseId String @db.Uuid

  // XOR garantido por CHECK na migration (`license_checkouts_alvo_xor`). Sem
  // discriminante: com dois alvos, a FK preenchida já diz qual é.
  assignedPersonId String? @db.Uuid
  assignedAssetId  String? @db.Uuid

  checkoutAt DateTime  @default(now())
  /// Nulo = EM USO. É o que a conta de livres desconta.
  checkinAt  DateTime?

  checkoutNotes String?

  /// A chave desta entrega (AC), uma das chaves da licença. Nula na licença sem
  /// chave cadastrada. Quando a licença tem chaves, a entrega nova escolhe uma.
  licenseKeyId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict nos quatro. A licença com entrega não se exclui (o 409 vem antes);
  // pessoa e ativo não se apagam de verdade enquanto têm histórico; a chave já
  // entregue não sai da lista.
  license        License     @relation(fields: [licenseId], references: [id], onDelete: Restrict)
  assignedPerson Person?     @relation(fields: [assignedPersonId], references: [id], onDelete: Restrict)
  assignedAsset  Asset?      @relation(fields: [assignedAssetId], references: [id], onDelete: Restrict)
  // FK COMPOSTA (chave, licença): a chave de outra licença não entra nem por
  // `psql`. Com `licenseKeyId` nulo, o Postgres não confere (MATCH SIMPLE).
  licenseKey     LicenseKey? @relation(fields: [licenseKeyId, licenseId], references: [id, licenseId], onDelete: Restrict, onUpdate: Restrict)

  // Uma entrega ABERTA por alvo e licença: índices únicos PARCIAIS na migration.
  @@index([licenseId, checkinAt])
  // Quantas entregas abertas cada chave tem — a conta da invariante 24.
  @@index([licenseKeyId, checkinAt])
  @@index([assignedPersonId, checkinAt])
  @@index([assignedAssetId, checkinAt])
  @@map("license_checkouts")
}

// ============================================================================
// CONVERGÊNCIA RMM × ITAM — docs/historico/fase-07-convergencia-rmm-itam.md (D45–D51, D95–D103)
//
// O `Endpoint` sabe o que a máquina É; o `Asset` sabe o que a empresa COMPROU e
// de quem cobra. Tudo aqui existe para ligar os dois SEM FUNDI-LOS (D45) e para
// transformar o que o agente OBSERVA em cadastro que uma pessoa CONFIRMA.
//
// A regra que atravessa a fase inteira: nada aqui escreve posse sozinho. A fila
// propõe, um humano aceita, e quem grava é o use-case da F4 — com o zod da
// borda, o AuditLog e as invariantes 1, 2 e 4 que já existem.
// ============================================================================

/// O que o sistema faz quando descobre máquina sem cadastro. `SUGGEST` por
/// padrão, e o porquê está no D51.
enum DiscoveryMode {
  OFF
  SUGGEST
  ON
}

/// POR QUE o sistema acha que este endpoint é este ativo. O ponto de cada um
/// está em `helpers/match-cascade.helper.ts`, não aqui: pontuação é regra de
/// negócio e muda; o nome do sinal é o vocabulário e não muda.
enum MatchSignal {
  SERIAL
  UUID
  HOSTNAME
}

/// O QUE a sugestão propõe. Um valor só hoje, e o enum fica: a fila é construída
/// em volta do que dá trabalho (nascer de um job idempotente, não duplicar,
/// guardar evidência, ser aceita ou recusada, lembrar da recusa), e isso não
/// depende de quantas formas existem.
enum SuggestionKind {
  /// Este endpoint é este ativo.
  LINK
}

enum SuggestionState {
  PENDING
  ACCEPTED
  REJECTED
  /// A evidência mudou e esta sugestão foi substituída por outra. Não é recusa:
  /// ninguém disse não, o mundo é que mudou.
  SUPERSEDED
}

// A FILA DE RECONCILIAÇÃO — uma tabela, e não uma por forma de sugestão (D96).
//
// POR QUE UMA SÓ: o que é caro é a fila (idempotência, deduplicação, evidência,
// aceite, memória da recusa), e uma tabela por forma seria uma cópia dessa
// máquina para variar o que é barato — qual é o alvo. Invariante copiada é
// invariante que um dia diverge.
//
// O `kind` continua existindo com um valor só porque é a fila que carrega o
// desenho, não a contagem de formas: o dia que nascer a segunda, ela entra aqui
// sem tabela nova.
model ReconciliationSuggestion {
  id   String         @id @default(uuid()) @db.Uuid
  kind SuggestionKind

  endpointId String @db.Uuid

  /// O alvo: o ativo que esta máquina É.
  assetId String? @db.Uuid

  /// 0 a 100, e todo ponto vem de sinal de hardware: é a cascata de identidade
  /// que pontua, não um palpite sobre gente.
  score  Int
  signal MatchSignal?

  /// O QUE o sistema viu — qual sinal casou, com que valor, em que hostname.
  /// Vai para a tela: sugestão sem evidência visível é palpite, e ninguém
  /// deveria aceitar um palpite que reescreve o inventário.
  evidence Json

  /// sha256 da evidência normalizada. É o que separa "já me disseram não sobre
  /// ISTO" de "já me disseram não sobre este par, faça o que fizer" (D97).
  evidenceHash String

  state      SuggestionState @default(PENDING)
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  endpoint Endpoint @relation("SugestaoDoEndpoint", fields: [endpointId], references: [id], onDelete: Cascade)
  asset    Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // O índice que impede a fila de empilhar (`sugestao_pendente_por_alvo`, com
  // COALESCE na FK nulável) é PARCIAL e nasce na migration escrita à mão.
  @@index([state, kind])
  @@index([endpointId, state])
  @@index([assetId])
  @@map("reconciliation_suggestions")
}

// MUDANÇA DE HARDWARE DETECTADA — trocou o HD, tiraram pente de RAM.
//
// Detectada, não digitada: a diferença com o `AuditLog` é essa. Lá a linha
// diz o que alguém FEZ no sistema; aqui, o que o mundo mudou sem avisar.
model AssetChange {
  id      String @id @default(uuid()) @db.Uuid
  assetId String @db.Uuid

  /// O nome do campo como o usuário o vê: "RAM total", "Disco", "Modelo".
  field    String
  oldValue String?
  newValue String

  detectedAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, detectedAt])
  @@map("asset_changes")
}

// ATIVO OCIOSO — quanto a máquina foi realmente usada, agregado por dia.
//
// Mesmo motivo do D49: sem agregação, "quem não usa este notebook há 30 dias"
// varre milhões de linhas de telemetria. E cruzado com o `postoVago` que o
// `resolverResponsaveis()` já devolve, isto separa "ninguém USA" de "ninguém
// RESPONDE" — duas conversas diferentes, com duas pessoas diferentes.
model AssetUsageDaily {
  id      String   @id @default(uuid()) @db.Uuid
  assetId String   @db.Uuid
  day     DateTime @db.Date

  /// Minutos com sinal de uso no dia, estimados pelas amostras de telemetria.
  activeMinutes Int @default(0)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, day])
  @@map("asset_usage_daily")
}

// ============================================================================
// ESTOQUE — o que tem QUANTIDADE, e não patrimônio.
//
// A régua contra o `Asset`: ATIVO É COMPUTADOR. Monitor, teclado, mouse, cabo e
// dock são estoque — N unidades intercambiáveis de um item, sem etiqueta nem
// série individual. Uma linha de `StockItem` é o item; cada unidade que sai é
// uma linha de `StockMovement`.
//
// O ITEM NÃO TEM COLUNA DE SALDO, e isso é decisão. `qty` é *quanto há no
// total* — só muda por ENTRADA e BAIXA, nunca pelo formulário —, e o disponível
// é `qty − COUNT(saídas abertas)`, calculado num helper só. Uma coluna
// `disponivel` mantida por decremento pode DIVERGIR das linhas — basta um
// INSERT que não passe pelo decremento — e a partir daí ela mente para sempre,
// porque ela *é* a resposta: não existe ninguém para discordar dela.
//
// O ITEM TEM LIXEIRA, ao contrário do catálogo: a leitura aninhada aqui é de
// HISTÓRICO — o nome do item na saída de março —, e mostrar o item apagado ali
// é o certo. O delete real levaria junto o histórico, que não se reconstrói.
// ============================================================================

// O que uma movimentação faz com o item.
//
//   ENTRADA  soma `qty` ao total — chegou nota, recontagem para cima.
//   BAIXA    subtrai `qty` do total — quebrou, perdeu, recontagem para baixo.
//            Nunca abaixo do que está fora (`adjust-stock`).
//   SAIDA    UMA unidade entregue a pessoa ou posto; `returnedAt` nulo é a
//            unidade fora do estoque, e é o que o saldo conta. A devolução
//            preenche `returnedAt` e NUNCA apaga a linha.
enum StockMovementKind {
  ENTRADA
  BAIXA
  SAIDA
}

// Para QUEM uma unidade saiu. Só nos movimentos de SAIDA.
enum StockTarget {
  PERSON
  WORKSTATION
}

model StockItem {
  id   String @id @default(uuid()) @db.Uuid
  name String

  // QUANTO HÁ NO TOTAL — não quanto sobra. Só muda por movimento de ENTRADA ou
  // BAIXA, na mesma transação que grava a linha; a chave NÃO existe no schema
  // de edição (`strictObject` devolve 422 a chave desconhecida, e não declarar
  // é a defesa).
  qty Int

  categoryId String  @db.Uuid
  notes      String?

  // ONDE O ESTOQUE FICA GUARDADO — o Depósito de TI. Opcional: item recém-
  // cadastrado pode ainda não ter lugar. É onde está o que SOBRA; a unidade
  // entregue a alguém está com quem a recebeu (`StockMovement`).
  locationId String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Restrict: é o 409 por uso do catálogo, e a FK é a rede embaixo dele.
  category  Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Restrict, como a categoria: o local que guarda estoque é "em uso" e se
  // desativa, não se exclui (`locationSpec.countUsages`).
  location  Location?       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  // `name` NÃO é @unique aqui: a unicidade é índice PARCIAL
  // (`WHERE "deletedAt" IS NULL`) na migration — o `unique_undeleted` de novo.
  // Com @unique comum, um item na lixeira travaria para sempre o recadastro do
  // mesmo nome.
  @@index([deletedAt])
  @@index([categoryId])
  @@index([locationId])
  @@map("stock_items")
}

// UMA LINHA POR MOVIMENTO, e a saída é UMA UNIDADE por linha.
//
// Entregar 5 mouses à Mesa 1 grava 5 linhas de SAIDA, e devolver é por linha:
// é o que faz a devolução ser de uma unidade identificada, sem quantidade
// parcial para dividir, e faz o saldo ser um `COUNT`. Entregar a um posto vale
// UMA unidade, qualquer que seja o número de ocupantes — o saldo do
// almoxarifado não pode depender da escala do RH. Quem responde por ela são os
// ocupantes abertos daquele posto, resolvidos na leitura.
//
// A forma da linha é CHECK do banco, escrito à mão na migration
// (`stock_movements_forma`): SAIDA tem exatamente um alvo, o discriminante
// preenchido e `qty = 1`; ENTRADA e BAIXA não têm alvo nem devolução. E o
// total do item não fica negativo (`stock_items_qty_nao_negativa`).
model StockMovement {
  id     String            @id @default(uuid()) @db.Uuid
  itemId String            @db.Uuid
  kind   StockMovementKind

  /// Quantas unidades este movimento moveu. Sempre 1 na SAIDA.
  qty Int

  // Discriminante + duas FKs nuláveis, como no `Assignment`. Só na SAIDA.
  targetType            StockTarget?
  targetPersonId        String?      @db.Uuid
  targetWorkstationId   String?      @db.Uuid
  /// O nome do posto, por escrito, quando ele foi excluído — como na `Assignment`.
  targetWorkstationName String?

  /// Só na SAIDA. Nulo = unidade FORA do estoque. É o que o saldo conta.
  returnedAt DateTime?

  /// A observação do movimento — por que entrou, por que saiu, para quem.
  notes String?

  createdAt DateTime @default(now())

  // Cascade no item dono do movimento. Restrict nos ALVOS: posto e pessoa são
  // catálogo, e o 409 de cada um conta as unidades fora — a FK é a rede embaixo
  // dele. A saída já devolvida para um posto excluído é desligada antes, com o
  // nome em `targetWorkstationName`.
  item              StockItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  targetPerson      Person?      @relation(fields: [targetPersonId], references: [id], onDelete: Restrict)
  targetWorkstation Workstation? @relation(fields: [targetWorkstationId], references: [id], onDelete: Restrict)

  @@index([itemId, kind, returnedAt])
  @@index([itemId, createdAt])
  @@index([targetPersonId, returnedAt])
  @@index([targetWorkstationId, returnedAt])
  @@map("stock_movements")
}
