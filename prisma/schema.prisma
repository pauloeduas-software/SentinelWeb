generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A máquina descoberta pelo Agente Sentinel (C#) — o lado RMM.
//
// Chamava-se `Asset` até a Fase 1. O nome foi liberado para o ativo do ITAM, que
// é o `Asset` do vocabulário do Snipe-IT. Aqui nenhuma coluna pode voltar a se
// chamar `status`, `lastSeen` ou `hwid` do outro lado: é essa ausência que faz o
// compilador barrar uma query do RMM que aponte para a tabela errada
// (docs/historico/fase-01-catalogo-e-ativo.md, D13).
model Endpoint {
  id       String @id @default(uuid()) @db.Uuid
  hwid     String @unique
  hostname String

  osVersion String

  // O EIXO DO AGENTE, e só ele. Enum desde a F7: era `String` livre, e o que
  // impedia `status = "Em uso"` de entrar aqui era a boa vontade de quem
  // escrevesse a query. O ciclo de vida do ativo é `StatusLabel`, outra tabela,
  // outro eixo (docs/historico/fase-07-convergencia-rmm-itam.md, D98).
  //
  // DOIS VALORES, e não os três que o TODO pedia: `NEVER_SEEN` seria um valor
  // que NENHUMA linha desta tabela pode ter, porque a linha nasce de um
  // handshake. "Cadastrado e nunca visto" é pergunta do ATIVO, e quem responde é
  // `Asset.lastSeenByAgentAt` no painel de cobertura.
  status   AgentStatus @default(ONLINE)
  lastSeen DateTime    @default(now())

  cpuModel          String?
  installedSoftware Json?
  localIp           String?
  macAddress        String?

  // ── IDENTIDADE COLETADA (F7, Etapa A) ────────────────────────────────────
  // Tudo nulável: o agente C# vive fora deste repositório e o rollout leva
  // semanas. Máquina que não manda serial não pontua por serial — não vira erro.
  biosSerial    String?
  systemUuid    String?
  manufacturer  String?
  /// `hardwareModel`, nunca `model`: `endpoint.model` lê-se como a relação de
  /// catálogo do ativo, e o compilador não pegaria a confusão (D13).
  hardwareModel String?
  chassisType   String?

  // SPECS COLETADAS — e elas moram AQUI, não em `assets`.
  //
  // O item do TODO pedia "specs de hardware como atributo do ativo". O que ele
  // queria de verdade era que o dado parasse de sumir no expurgo da telemetria,
  // e coluna nesta tabela resolve isso. Copiá-las para `assets` criaria uma
  // segunda fonte de verdade sobre a MESMA máquina, com um detalhe que a torna
  // pior que as outras: as duas podem divergir com razão (o pente foi trocado) e
  // ninguém saberia qual está certa. É o D16 uma camada abaixo.
  ramTotalBytes  BigInt?
  diskTotalBytes BigInt?

  /// Último usuário visto logado. Bruto, como veio: "DOMINIO\ana.silva".
  /// Quem o transforma em `userKey` é o helper da Etapa E.
  loggedOnUser String?

  /// sha256 da lista de software que o AGENTE mandou no último handshake.
  /// Calculado no servidor, nunca aceito do agente (D100).
  softwareHash String?

  /// sha256 da lista que as tabelas `software_installations` REFLETEM.
  ///
  /// São duas colunas, e não uma, porque elas respondem perguntas diferentes:
  /// a de cima é o que chegou, esta é o que foi processado. Com uma só, o job
  /// teria que re-hashear o JSON de 500 máquinas por hora para descobrir quem
  /// mudou — e o hash existe justamente para esse trabalho não acontecer.
  /// Diferentes = há o que normalizar, e a comparação é de duas colunas.
  softwareNormalizedHash String?

  /// Triagem do Shadow IT: máquina vista pelo agente e sem cadastro.
  reviewState ReviewState @default(UNREVIEWED)

  // ── O VÍNCULO COM O PATRIMÔNIO (D45) ─────────────────────────────────────
  //
  // A FK mora AQUI, e não em `assets`, por duas razões. A maioria dos ativos
  // nunca terá agente (monitor, cadeira, cabo, switch): no outro lado a coluna
  // ficaria nula na esmagadora maioria das linhas. E este é o lado que a
  // reconciliação ESCREVE.
  //
  // `@unique` garante o 1:1 sem tabela de junção. `SetNull` garante que apagar
  // um ativo não leve junto a telemetria da máquina — mas note que ele desfaz o
  // vínculo EM SILÊNCIO, e é por isso que o `unlink` tem linha no ActivityLog.
  assetId String? @unique @db.Uuid
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  /// Fundido em outro endpoint (reimagem, troca de placa). A linha FICA (D103):
  /// o agente antigo pode voltar, e o `ApiToken` daquela instalação aponta para
  /// este id.
  mergedIntoId String?    @db.Uuid
  mergedInto   Endpoint?  @relation("EndpointMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  merged       Endpoint[] @relation("EndpointMerge")

  telemetries   Telemetry[]
  userDays      EndpointUserDaily[]
  installations SoftwareInstallation[]
  suggestions   ReconciliationSuggestion[] @relation("SugestaoDoEndpoint")
  mergeTargetOf ReconciliationSuggestion[] @relation("SugestaoDeMerge")
  changes       AssetChange[]

  @@index([assetId])
  @@index([reviewState])
  @@map("endpoints")
}

// O eixo do AGENTE. Ver a nota em `Endpoint.status` para por que são dois
// valores e não três (D98).
enum AgentStatus {
  ONLINE
  OFFLINE
}

// A triagem do Shadow IT: máquina que o agente vê e o cadastro não conhece.
// `UNREVIEWED` é o estado de quem acabou de aparecer — a fila de trabalho.
enum ReviewState {
  UNREVIEWED
  ALLOWED
  BLOCKED
}

model Telemetry {
  id           String   @id @default(uuid()) @db.Uuid
  endpointId   String   @db.Uuid
  cpuUsage     Float
  ramTotal     BigInt
  ramUsed      BigInt
  timestamp    DateTime @default(now())
  disks        Json?
  network      Json?
  topProcesses Json?
  endpoint     Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@map("telemetries")
}

/// Os três papéis da autorização (D148). A ordem do enum é a hierarquia, e a
/// comparação mora em `access/helpers/papel.ts` — nunca num `indexOf` por fora.
enum Papel {
  USUARIO
  TECNICO
  ADMIN
}

model User {
  id    String @id @default(uuid()) @db.Uuid
  name  String
  email String

  // O DEPARTAMENTO — uma FK, e só (F11, Etapa J — D75).
  //
  // A coluna de TEXTO `department` existiu aqui desde a F1 e caiu na migração 2 de
  // 2, depois de a lista de departamentos ter sido revisada à mão. A troca foi em
  // dois tempos de propósito: entre as duas migrações, um rollback ainda encontrava
  // o texto original — com `add`+`backfill`+`drop` num commit só, voltar atrás é
  // perda de dado.
  //
  // E é por isso que a relação abaixo volta a se chamar `department`, sem
  // sublinhado: o nome estava ocupado pela coluna em transição, e com ela fora a
  // borda não precisa mais achatar nada (o `comDepartamento()` do
  // `user-select.helper.ts` deixou de existir junto).
  departmentId String? @db.Uuid

  // AUTENTICAÇÃO (F3). Nulável porque a base nasceu sem login: um colaborador
  // cadastrado para receber equipamento não precisa de acesso ao sistema, e
  // exigir senha de todo mundo tornaria a carga inicial impossível.
  //
  // `username` NÃO é @unique aqui: a unicidade é índice PARCIAL
  // (`WHERE deleted_at IS NULL`) na migration, o mesmo caso de `email` — um
  // usuário na lixeira travaria para sempre o recadastro do mesmo login.
  username     String?
  passwordHash String?

  // Bloqueio por tentativa. `lockedUntil` no futuro recusa o login mesmo com a
  // senha certa; quem zera os dois é o login bem-sucedido.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // A GERAÇÃO DA SESSÃO — o que faz trocar a senha DERRUBAR quem já está dentro.
  //
  // O buraco que isto fecha: a releitura por requisição
  // (`current-user.usecase.ts`) mata a sessão de quem foi apagado ou desligado,
  // mas NÃO a de quem continua sendo um usuário válido. Então quem roubasse o
  // cookie seguia operando por até 8 horas mesmo DEPOIS de a vítima trocar a
  // senha — que é justamente o que a vítima faz ao desconfiar.
  //
  // O número vai assinado dentro do JWT e é conferido contra esta coluna a cada
  // requisição: incrementar aqui invalida, de uma vez, todo token emitido antes
  // — sem tabela de sessão e sem lista de revogação.
  tokenVersion Int @default(0)

  // Último login bem-sucedido. Não é enfeite de perfil: em inventário, "quem
  // ainda usa o sistema" é a pergunta que antecede a limpeza de acessos.
  lastLoginAt DateTime?


  // ─────────────────────────────────────────────────────────────────────────
  // IDENTIDADE DO COLABORADOR (F11, Etapa E).
  //
  // `employeeNumber` tem unicidade por índice PARCIAL (`WHERE "deletedAt" IS
  // NULL`) na migration, o mesmo caso de `email` e `username`: uma matrícula na
  // lixeira travaria para sempre o recadastro da mesma pessoa.
  //
  // `firstName`/`lastName` NÃO EXISTEM, apesar de o TODO pedir "nome dividido":
  // `name` já é o campo canônico, dividi-lo exige um backfill que adivinha onde
  // termina o nome em "Maria da Silva Souza", e um campo que só existe para ser
  // recomposto na exibição é duas fontes de verdade para o mesmo dado. De
  // LDAP/OIDC o que importa guardar é `employeeNumber` e `jobTitle`.
  employeeNumber String?
  jobTitle       String?
  phone          String?
  address        String?

  /// Admissão. Não é `createdAt`: a pessoa trabalha aqui desde antes do sistema.
  hiredAt DateTime?

  // GESTOR DA PESSOA — a hierarquia de gente, em auto-relação.
  //
  // ⚠️ ELE NÃO ENTRA EM `resolverResponsaveis()`, e isto é o D72. Gestor é ROTA
  // DE ESCALONAMENTO, não detentor: ele recebe o aviso de atraso e aprova a
  // baixa. Responsabilidade por ativo é *quem está com o equipamento*, e quem
  // responde é a posse aberta ou os ocupantes do posto (D16). Se um dia "o
  // gestor responde junto" for regra do cliente, é decisão NOVA e explícita —
  // não efeito colateral de esta coluna existir.
  //
  // `SetNull`: desligar o gestor não pode derrubar os liderados junto.
  managerId String? @db.Uuid

  // Desligamento (F11) é diferente de lixeira: quem saiu da empresa continua no
  // histórico de posse e nos relatórios, só não opera mais.
  isActive         Boolean            @default(true)

  // O PAPEL (D148), no lugar da matriz de permissões por grupo (D76).
  //
  // `USUARIO` é o padrão e é o que a porta fechada da F3 pede: conta nova não
  // alcança nada além de si mesma, e quem quiser mais escreve a linha. A rede
  // que impede o sistema de ficar sem ninguém que entre está em
  // `access/helpers/ultimo-administrador.ts`, chamada no fim da transação.
  role Papel @default(USUARIO)
  terminatedAt     DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  assets           Asset[]
  managedLocations Location[]
  // Posses diretas (alvo USER) e postos de trabalho que esta pessoa ocupa.
  // Responsabilidade real = as duas somadas (docs/referencia/modelo-de-posse.md, Camada 3).
  assignments      Assignment[]
  occupancies      LocationOccupant[]

  // ESTOQUE (F5). O acessório entregue à pessoa volta; o consumível não — e é
  // por isso que os dois são tabelas separadas, não um enum numa só (D37).
  accessoryCheckouts  AccessoryCheckout[]
  consumableCheckouts ConsumableCheckout[]

  // LICENÇA (F6). Assento vai para pessoa ou ativo, nunca para um posto (D39).
  licenseSeats LicenseSeatCheckout[]

  // CONVERGÊNCIA (F7). O que o agente OBSERVOU sobre esta pessoa e o que o
  // sistema PROPÔS por causa disso — nenhum dos dois é posse: posse continua
  // sendo `Assignment` e `LocationOccupant`, e é por lá que a sugestão aceita
  // passa a existir.
  endpointDays EndpointUserDaily[]
  suggestions  ReconciliationSuggestion[]

  // OS TOKENS PESSOAIS (F11, Etapa H). A relação nasce com a FK que o `userId`
  // não tinha (D142) — ver o `model ApiToken` para por que ela é `Cascade`.

  // ACESSO (F11). Os grupos de que esta pessoa participa — a permissão efetiva
  // é a UNIÃO das permissões deles (D76). Sem grupo, ela entra no sistema e não
  // alcança nada: é a porta fechada por padrão da F3 levada à autorização.

  // ─────────────────────────────────────────────────────────────────────────
  // AS TRÊS HIERARQUIAS QUE PASSAM POR UMA PESSOA (F11, Etapa C — D72).
  //
  // Elas parecem todas responder "de quem é isto?" e respondem a perguntas
  // diferentes. A tabela inteira está em docs/referencia/modelo-de-posse.md:
  //
  //   quem RESPONDE pelo ativo?        a posse aberta → pessoa, ou os
  //                                     ocupantes do posto  (`resolverResponsaveis`)
  //   quem COBRA a pessoa?             `managerId`          (hierarquia de gente)
  //   quem responde pelo ESPAÇO, e     `Location.managerId`, subindo a árvore
  //     pelo posto SEM ocupante?        (`resolverEscalonamento`)
  //   a quem PERTENCE o custo?         `Department`         (relatório e rateio)
  //
  // Em uma linha: *o posto responde pelo ativo; a pessoa responde pelo posto; o
  // gestor da localidade responde pelo posto vazio — e nunca pelo posto
  // ocupado.*
  department    Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: Restrict)
  departmentsManaged Department[] @relation("DepartmentManager")
  manager       User?        @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports       User[]       @relation("UserManager")

  // `email` NÃO é @unique aqui de propósito: a unicidade é um índice parcial
  // (`WHERE deleted_at IS NULL`) criado na migration. Com @unique comum, um
  // usuário na lixeira bloquearia para sempre o recadastro do mesmo e-mail —
  // é o `unique_undeleted` do Snipe-IT (docs/ROADMAP.md, F2).
  @@index([email])
  @@index([deletedAt])
  @@index([departmentId])
  @@index([managerId])
  @@map("users")
}

// Trilha de auditoria: o que mudou, quando e por quem.
//
// `actorId` é nulável e SEM relação com `User` de propósito. Nulável porque
// autenticação é a Fase 3 — esperar por ela significaria perder o histórico de
// tudo que for cadastrado até lá. Sem FK porque log de auditoria é append-only:
// a integridade dele não pode depender do ciclo de vida da linha do usuário.
model Department {
  id   String  @id @default(uuid()) @db.Uuid
  name String  @unique
  code String?

  // GESTOR DO DEPARTAMENTO. `SetNull` de propósito: desligar o gestor não pode
  // derrubar o departamento junto.
  //
  // ⚠️ ELE NÃO RESPONDE POR ATIVO NENHUM, e isto é o D72. Departamento agrupa
  // PESSOAS — serve para relatório ("quanto o Comercial tem em equipamento"),
  // rateio de custo e filtro de tela. Entregar "para o Comercial" é entregar
  // para uma sala ou para uma pessoa: departamento não tem mesa, não tem chave
  // e não assina nada. Quem responde por um ativo é a posse aberta, e quando o
  // alvo é um posto, os ocupantes dele (D16, docs/referencia/modelo-de-posse.md).
  managerId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manager User?  @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  // `Restrict`: apagar um departamento com gente dentro deixaria as pessoas
  // apontando para o nada. A recusa é 409 pela contagem de uso, como em toda
  // tabela de catálogo (D8).
  members User[] @relation("DepartmentMembers")

  @@index([managerId])
  @@map("departments")
}


model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     String
  changes    Json?
  actorId    String?  @db.Uuid
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}




// ============================================================================
// CATÁLOGO — as tabelas que o Snipe-IT chama de *Settings* (docs/historico/fase-01-catalogo-e-ativo.md)
//
// Nenhuma tem `deletedAt`, e isso é decisão, não esquecimento (D8): a extension
// de soft delete descobre a lixeira pela PRESENÇA da coluna, então a ausência é
// o opt-out. A proteção aqui é o 409 por uso — que é o que o Snipe-IT realmente
// faz ao recusar apagar categoria com item associado. Manter lixeira no catálogo
// custaria sete índices únicos parciais, o `upsert` do seed e uma camada de
// apresentação para esconder relação apagada (a extension não alcança leitura
// aninhada — verificado).
// ============================================================================

enum CategoryType {
  ASSET
  ACCESSORY
  CONSUMABLE
  COMPONENT
  LICENSE
}

// O tipo do status responde: *o que dá para fazer com este ativo agora?*
//
//   DEPLOYABLE   — está no estoque e pode ser entregue. O único que libera o
//                  checkout da F4.
//   IN_USE       — está com alguém ou instalado em algum lugar. Fora do estoque
//                  porque está CUMPRINDO a função dele.
//   PENDING      — fora do estoque por algum impedimento, e volta: em reparo,
//                  em diagnóstico, em trânsito, à espera de preparo.
//   UNDEPLOYABLE — ainda é patrimônio seu, mas não serve mais e não volta:
//                  danificado sem conserto, perdido, roubado.
//   ARCHIVED     — saiu da operação (vendido, descartado, doado). Sai das
//                  listagens do dia a dia.
//
// `IN_USE` é tipo PRÓPRIO, e não `PENDING`, porque a diferença entre "está com
// um colaborador" e "está na assistência" é a distinção mais cara do inventário:
// um está gerando valor, o outro está custando. Empacotar os dois em `PENDING`
// torna "quantos ativos estão em uso?" — a métrica principal do módulo —
// inexpressável pelo tipo.
//
// Também não é derivado de `assignedToId`: `statusId` é obrigatório no cadastro,
// a carga inicial é feita de equipamento que já está com gente, e existe uso SEM
// responsável (o monitor parafusado na sala de reunião).
//
// A ordem dos valores é a do ciclo de vida, e o Postgres a usa em `ORDER BY`
// sobre a coluna — por isso `IN_USE` entra DEPOIS de `DEPLOYABLE` na migration,
// e não no fim.
enum StatusLabelType {
  DEPLOYABLE
  IN_USE
  PENDING
  ARCHIVED
  UNDEPLOYABLE
}

// Por que o ativo saiu do patrimônio. Fechado de propósito: é campo de
// relatório contábil, e texto livre aqui vira "vendido", "Vendido" e "venda"
// na mesma coluna (D5).
enum RetiredReason {
  VENDIDO
  DESCARTADO
  DOADO
  EXTRAVIADO
  ROUBADO
  GARANTIA
}


model Category {
  id   String       @id @default(uuid()) @db.Uuid
  name String
  type CategoryType

  color String?

  // Inertes até a F4 (fluxo de aceite): a categoria é quem decide se a entrega
  // exige assinatura e qual EULA é apresentado.
  requireAcceptance Boolean @default(false)
  eulaText          String?
  checkinEmail      Boolean @default(false)

  // Imagem. Só o CAMINHO, nunca os bytes — quem guarda o arquivo é o
  // `UPLOAD_DIR` (server/core/storage/). BLOB no banco dobra o tamanho do dump
  // e faz cada leitura carregar megabytes que ninguém pediu.
  imagePath String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assetModels AssetModel[]

  // Os três tipos COM QUANTIDADE (F5). Cada um tem a categoria própria, e é o
  // `type` desta linha que separa: um `Accessory` de categoria `ASSET` é o
  // mesmo erro que "Em Uso" tipado DEPLOYABLE foi na F1. O banco não impede —
  // a guarda é do use-case, e o `optionFilter` da spec protege a tela.
  accessories Accessory[]
  consumables Consumable[]
  components  Component[]
  licenses    License[]

  // O CONJUNTO DE CAMPOS CUSTOMIZADOS PADRÃO (F9, D58).
  //
  // A categoria é a âncora PADRÃO; o modelo sobrepõe quando preenchido. Aqui
  // porque "todo notebook pede número de patrimônio" é regra de CATEGORIA — o
  // campo que o cliente realmente quer é da categoria *Notebook*, não do
  // *Latitude 5420*.
  //
  // `Restrict`: apagar um conjunto que uma categoria usa é recusado com 409 e a
  // contagem, em vez de zerar a âncora em silêncio — que é o que um `SetNull`
  // faria, deixando a categoria inteira sem campos sem ninguém tocar nela.

  // Por (nome, tipo), não só por nome: "Notebook" como categoria de ATIVO e
  // "Notebook" como categoria de LICENÇA são duas coisas diferentes.
  @@unique([name, type])
  @@map("categories")
}

model StatusLabel {
  id   String          @id @default(uuid()) @db.Uuid
  name String          @unique
  type StatusLabelType

  color     String?
  showInNav Boolean @default(false)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]

  @@map("status_labels")
}

model Manufacturer {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  url          String?
  supportPhone String?
  supportEmail String?
  supportUrl   String?

  // Imagem. Só o CAMINHO, nunca os bytes — quem guarda o arquivo é o
  // `UPLOAD_DIR` (server/core/storage/). BLOB no banco dobra o tamanho do dump
  // e faz cada leitura carregar megabytes que ninguém pediu.
  imagePath String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assetModels AssetModel[]

  accessories Accessory[]
  consumables Consumable[]
  components  Component[]
  licenses    License[]

  @@map("manufacturers")
}

model AssetModel {
  id   String @id @default(uuid()) @db.Uuid
  name String

  // Vida útil em meses. O ativo herda daqui e pode sobrescrever (F1/G).
  eolMonths   Int?
  modelNumber String?
  notes       String?

  manufacturerId String @db.Uuid
  categoryId     String @db.Uuid

  // A REGRA DE DEPRECIAÇÃO, e ela pendura AQUI (F8, Etapa C).
  //
  // No modelo e não no ativo, por dois motivos que se reforçam: `Asset` não tem
  // `categoryId` (a categoria vem daqui), e vida útil contábil é característica
  // do EQUIPAMENTO — todo notebook daquele modelo deprecia igual. É também onde
  // o Snipe-IT a pendura.
  //
  // Nulável de propósito: a maioria dos modelos nunca terá regra, e valor
  // contábil sem regra é `null`, nunca zero (D55).

  // Imagem. Só o CAMINHO, nunca os bytes — quem guarda o arquivo é o
  // `UPLOAD_DIR` (server/core/storage/). BLOB no banco dobra o tamanho do dump
  // e faz cada leitura carregar megabytes que ninguém pediu.
  imagePath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict é a rede embaixo do 409 do `countUsages`: mesmo que a checagem da
  // aplicação seja esquecida, o banco recusa e o P2003 vira 409 no errorHandler.
  manufacturer Manufacturer  @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // O CONJUNTO DE CAMPOS CUSTOMIZADOS QUE SOBREPÕE A CATEGORIA (F9, D58).
  //
  // `fieldset = model.customFieldsetId ?? model.category.customFieldsetId`, e a
  // resolução mora numa função só (`resolve-fieldset.usecase.ts`). É o único
  // jeito de expressar o campo que só existe num modelo — o IMEI do tablet 4G.
  //
  // Três níveis (categoria → modelo → ativo) ficaram de fora pelo motivo que
  // limita o salto de `ASSET` no D16: cadeia mais longa é sintoma de modelagem
  // errada e custa um salto de consulta a cada leitura.
  //
  // A F1 adiou este atributo e o `docs/ROADMAP.md` chegou a dizer que a coluna
  // estava "reservada" — não estava: FK para tabela inexistente é impossível,
  // não adiável. As duas colunas nascem aqui, na F9.

  assets Asset[]

  // Vários modelos SEM número convivem: o Postgres trata NULL como distinto,
  // então não é preciso índice parcial aqui (verificado).
  @@unique([manufacturerId, modelNumber])
  @@index([categoryId])
  @@map("asset_models")
}

model Supplier {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  contactName String?
  phone       String?
  email       String?
  url         String?
  address     String?
  city        String?
  state       String?
  zip         String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]

  accessories  Accessory[]
  consumables  Consumable[]
  components   Component[]
  licenses     License[]
  // A manutenção paga por fornecedor (F8). `Restrict` do lado de lá, como as
  // outras cinco: é a rede embaixo do 409 do `countUsages`.

  @@map("suppliers")
}

model Location {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  parentId String? @db.Uuid
  address  String?
  city     String?
  state    String?
  zip      String?
  phone    String?
  notes    String?

  // POSTO DE TRABALHO — a Mesa 1, a bancada, o guichê.
  //
  // O posto É uma `Location` (D15): a árvore já existe, o ativo já aponta para
  // ela, e criar uma `Workstation` paralela duplicaria a hierarquia. Mas uma
  // bancada NÃO é uma filial: endereço, CEP e telefone não querem dizer nada
  // numa mesa, e misturar as duas numa lista só foi o que tornou o posto
  // invisível na interface.
  //
  // Esta flag é de APRESENTAÇÃO, não de regra: ela separa as duas coisas nas
  // telas e habilita a página /postos. Nenhuma invariante depende dela — um
  // local sem a marca continua podendo receber ativo e ocupante, porque
  // proibir isso quebraria a sala de reunião que já funciona hoje.
  isWorkstation Boolean @default(false)

  // Gestor da localidade. SetNull de propósito: desligar o gestor não pode
  // derrubar a filial junto.
  managerId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // O banco NÃO impede ciclo (A→B→A foi aceito no teste): a guarda de ciclo é
  // da aplicação, em helpers/location-cycle.helper.ts.
  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Location[] @relation("LocationTree")
  manager  User?      @relation(fields: [managerId], references: [id], onDelete: SetNull)
  assets   Asset[]

  // Ativos entregues A ESTE LOCAL (alvo LOCATION) e as pessoas que o ocupam.
  // É a junção das duas que responde "quem é responsável pelo mouse da Mesa 1".
  assignments Assignment[]
  occupants   LocationOccupant[]

  // ONDE O ESTOQUE MORA — o almoxarifado, a gaveta. É `locationId` do item, e
  // NÃO tem nada a ver com a entrega: quem recebeu está em `accessoryCheckouts`.
  accessories Accessory[]
  consumables Consumable[]
  components  Component[]

  // Acessórios entregues A ESTE POSTO (D33): os 5 mouses da Mesa 1. Quem
  // responde por eles são os OCUPANTES, resolvidos na leitura — a unidade é
  // UMA, qualquer que seja o número de pessoas na escala.
  accessoryCheckouts AccessoryCheckout[]

  // DECLARADOS AQUI, e não só na migration que os criou.
  //
  // Os dois nasceram à mão em `20260923102207_postos_descomissionamento_auth` e
  // ficaram de fora do schema. Consequência: o `migrate diff` não os via, achava
  // que eram lixo do banco e emitia `DROP INDEX` em TODA migração seguinte —
  // derrubando índice útil em silêncio para quem aplicasse o SQL sem ler.
  //
  // São índices COMUNS, que o Prisma expressa. Os PARCIAIS (`WHERE …`) continuam
  // só no SQL porque ele não os expressa, e esses o `migrate diff` ignora em vez
  // de tentar remover — a diferença é essa, e é o que separa "mora na migration
  // de propósito" de "ficou para trás".
  suggestions ReconciliationSuggestion[]

  @@index([parentId])
  @@index([isWorkstation])
  @@map("locations")
}







// ============================================================================
// O ATIVO — o coração do ITAM (docs/historico/fase-01-catalogo-e-ativo.md, Etapa G)
// ============================================================================

// Um ativo = UM equipamento físico, com etiqueta e série próprias.
//
// Não existe `quantity` aqui, e é de propósito (D3): quantidade é semântica de
// `Accessory`, `Consumable` e `Component`, que nascem na F5. O `InventoryItem`
// achatado com quantidade que existia antes foi removido junto com esta tabela.
//
// NÃO há `categoryId`: a categoria do ativo é a do MODELO (`model.category`) —
// é assim no Snipe-IT, e é o que impede um ativo e o seu modelo divergirem de
// categoria. Por isso `modelId` é obrigatório.
//
// NENHUMA coluna aqui pode se chamar `status`, `lastSeen` ou `hwid`: são os
// nomes do `Endpoint` (lado RMM), e é a ausência deles que faz o compilador
// barrar uma query do RMM que aponte para esta tabela (D13). Quando a F7 for
// registrar o último contato do agente, o campo chama `lastSeenByAgentAt`.
model Asset {
  id String @id @default(uuid()) @db.Uuid

  // Unicidade de `assetTag` e `serial` é índice PARCIAL (`WHERE deleted_at IS
  // NULL`), criado à mão na migration — NÃO `@unique`. Com unique comum, um
  // ativo na lixeira travaria para sempre o recadastro da mesma etiqueta. É o
  // `unique_undeleted` do Snipe-IT, o mesmo caso de `User.email` na Fase 0.
  assetTag String
  serial   String?

  name  String?
  notes String?

  byod        Boolean @default(false)
  requestable Boolean @default(false)

  statusId     String  @db.Uuid
  modelId      String  @db.Uuid
  // ONDE o ativo está. NÃO é quem responde por ele — ver `assignedToId` abaixo e
  // docs/referencia/modelo-de-posse.md: um ativo pode estar EM um lugar sem ser DO lugar (o
  // mouse reserva na gaveta de uma mesa ocupada).
  locationId   String? @db.Uuid
  supplierId   String? @db.Uuid
  // CACHE do caso `USER`, e só dele. A fonte de verdade da posse é a
  // `Assignment` aberta (docs/referencia/modelo-de-posse.md, Camada 1).
  //
  // Fica `null` quando o detentor é uma LOCALIZAÇÃO (a Mesa 1, cujos
  // responsáveis são os ocupantes dela) ou OUTRO ATIVO (a dock presa ao
  // notebook). Quem lê "quem responde por este ativo" chama
  // `resolverResponsaveis()`, nunca esta coluna sozinha.
  //
  // NÃO é editável pelo formulário de ativo — saiu do `createAssetSchema` e do
  // `updateAssetSchema` na F4. Escrevem aqui SÓ o checkout e o checkin: campo
  // editável à mão ao lado de uma tabela de posse são duas fontes de verdade
  // para o mesmo fato, e nada impede divergirem (D14).
  assignedToId String? @db.Uuid

  orderNumber  String?
  purchaseDate DateTime?
  // Decimal, nunca Float. Sai no JSON como string.
  purchaseCost Decimal?  @db.Decimal(12, 2)

  // `warrantyExpiresAt` e `eolDate` são CALCULADAS no save, a partir dos meses e
  // da data de compra. `eolExplicit` marca que alguém sobrescreveu a data à mão
  // e que o cálculo não deve mais mexer nela.
  warrantyMonths    Int?
  warrantyExpiresAt DateTime?
  eolMonths         Int?
  eolDate           DateTime?
  eolExplicit       Boolean   @default(false)

  // DESCOMISSIONAMENTO — o ativo saiu do parque, e por quê.
  //
  // São TRÊS colunas diferentes e nenhuma substitui a outra (D19):
  //   `status.type = ARCHIVED` — saiu da operação, some das listagens do dia a dia
  //   `retiredAt`              — saiu do PATRIMÔNIO: vendido, descartado, roubado
  //   `deletedAt`              — foi cadastrado errado e está na lixeira
  // Um ativo vendido é um fato contábil e continua nos relatórios; um ativo na
  // lixeira é um erro de digitação e não deveria ter existido.
  retiredAt     DateTime?
  retiredReason RetiredReason?

  // Foto do equipamento. Só o CAMINHO — ver o mesmo campo no catálogo.
  imagePath String?

  // ── OS VALORES DOS CAMPOS CUSTOMIZADOS (F9, D59) ─────────────────────────
  //
  // JsonB na PRÓPRIA LINHA do ativo, com o `slug` do campo como chave. Nem uma
  // coluna por campo (o que o Snipe-IT faz, e que aqui morreria no `migrate
  // diff` da próxima migration como drift), nem uma tabela EAV (uma linha por
  // campo por ativo transforma a listagem num pivô).
  //
  // ⚠️ `Prisma.DbNull` × `Prisma.JsonNull`: ativo SEM campos customizados grava
  // `DbNull` — coluna nula. Com `JsonNull` o banco guardaria o literal JSON
  // `null` DENTRO da coluna, `customFields IS NULL` pararia de achá-lo, e a
  // contagem de "sem campos preenchidos" passaria a mentir. É a armadilha mais
  // barata de cair e a mais cara de achar depois.
  //
  // O conteúdo é validado no USE-CASE, não na borda: o `strictObject` do schema
  // de entrada recusa chave desconhecida e não PODE conhecer campos criados em
  // runtime (`validate-custom-fields.usecase.ts`).

  // QUEM cadastrou e QUEM editou por último.
  //
  // Duas colunas AQUI, e não nas catorze tabelas (D26): o `ActivityLog` já
  // responde "quem criou isto" — a linha `CREATE` está lá, com o ator. A coluna
  // existe para não fazer essa consulta POR LINHA na tela de detalhe do ativo,
  // que é a única que mostra o dado.
  //
  // SEM relação com `User`, pelo mesmo motivo do `ActivityLog.actorId`: se o
  // cadastro de quem criou o ativo for excluído, a autoria não pode virar
  // `SetNull` nem impedir a exclusão. É carimbo, não vínculo.
  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  status     StatusLabel @relation(fields: [statusId], references: [id], onDelete: Restrict)
  model      AssetModel  @relation(fields: [modelId], references: [id], onDelete: Restrict)
  location   Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplier   Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  assignedTo User?       @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  // A posse deste ativo, aberta e histórica.
  assignments     Assignment[] @relation("AssignmentAsset")
  // As posses em que este ativo é o DETENTOR (a dock que segura o notebook).
  heldAssignments Assignment[] @relation("AssignmentTargetAsset")

  attachments Attachment[]

  // O QUE ESTÁ DENTRO DESTE ATIVO — a primeira ponte real entre estoque e
  // ativo (F5). O pente de RAM não tem etiqueta própria, então é `Component`;
  // a dock tem, então é `Asset` com `Assignment` de alvo `ASSET` (F4).
  components ComponentAsset[]

  // Os assentos de licença que esta máquina ocupa (F6).
  licenseSeats LicenseSeatCheckout[]

  // ── A CONVERGÊNCIA COM O RMM (F7) ────────────────────────────────────────
  //
  // `lastSeenByAgentAt`, e NUNCA `lastSeen` (D13). Se esta coluna se chamasse
  // `lastSeen`, o `markStaleEndpointsOffline` apontando para o model errado
  // COMPILARIA — e marcaria a frota inteira como OFFLINE em silêncio. Com o nome
  // diferente, o mesmo erro vira erro de compilação.
  //
  // QUEM ESCREVE É O JOB, não o handshake (D95). O `touchEndpoint` roda a cada
  // mensagem de cada máquina; um UPDATE condicional em `assets` ali seria
  // executado milhões de vezes por dia para quase nunca casar, e acoplaria a
  // tabela de patrimônio ao caminho de ingestão. A pergunta que esta coluna
  // responde — "não é visto há quantos dias?" — tolera uma hora de atraso.
  //
  // E ela EXISTE, em vez de ser derivada pelo `Endpoint`, porque reimagem cria
  // endpoint novo (o `hwid` muda) e o histórico de "um agente já viu este ativo"
  // não pode zerar junto.
  lastSeenByAgentAt DateTime?

  // ── A CONFERÊNCIA FÍSICA (F8) ────────────────────────────────────────────
  //
  // CACHE DE EVENTO, no molde do `assignedToId`: escritor único (o use-case de
  // auditoria), fato que aconteceu, e existe porque *"quais ativos nunca foram
  // auditados"* é pergunta sobre a frota inteira — respondê-la por `MAX()` sobre
  // `audits` a cada carregamento de relatório varreria a tabela de histórico.
  //
  // E `nextAuditAt` NÃO EXISTE, de propósito (D53). Ela seria
  // `lastAuditAt + intervalo`, e o intervalo é configuração GLOBAL: no dia em
  // que alguém trocar 12 meses por 6, toda linha gravada antes passa a mentir, e
  // a correção é um UPDATE em massa que ninguém vai lembrar de rodar. O corte é
  // calculado na consulta, a partir de `AppSetting.auditIntervalMonths`.

  /// A máquina descoberta que É este ativo. Lado fraco do 1:1 — a FK mora lá (D45).
  endpoint Endpoint?

  changes   AssetChange[]
  usageDays AssetUsageDaily[]

  // ── O CICLO DE VIDA (F8) ─────────────────────────────────────────────────
  // `suggestions`, e não o `ReconciliationSuggestion` que o `prisma format`
  // escreveu sozinho: o nome gerado não é convenção nenhuma e destoa dos outros
  // três lados da mesma relação (`Endpoint`, `User` e `Location` todos a chamam
  // de `suggestions`). Nome de campo de relação não existe no banco, então isto
  // NÃO pede migração — o que ele muda é o que se lê no `include`.
  suggestions  ReconciliationSuggestion[]

  @@index([deletedAt])
  @@index([statusId])
  @@index([modelId])
  @@index([locationId])
  @@index([assignedToId])
  // Ver a nota em `Location`: declarado aqui para o `migrate diff` parar de
  // emitir `DROP INDEX` dele a cada migração nova.
  @@index([retiredAt])
  @@index([lastSeenByAgentAt])
  // O ÍNDICE DOS CAMPOS CUSTOMIZADOS (F9, D63).
  //
  // `JsonbOps` e NÃO `JsonbPathOps`: o segundo é menor e mais rápido para `@>`,
  // mas não suporta o operador `?` (existência de chave) — e *"ativos que têm o
  // campo X preenchido"* é a primeira pergunta da tela de administração. Paga-se
  // o tamanho do índice pela pergunta.
  //
  // ⚠️ QUEM SE PAGA COM ELE SÃO AS CONTAGENS, NÃO O FILTRO DA LISTAGEM.
  //
  // O GIN serve `@>` (contenção) e `?` (existência), e o Prisma TIPADO não os
  // emite: `customFields: { path: [slug], equals: valor }` sai como
  //
  //     WHERE ("customFields" #> ARRAY['ip_fixo']::text[])::jsonb = $1
  //
  // que é comparação de EXPRESSÃO — Seq Scan. Medido em 50 mil linhas: 13,5 ms
  // nessa forma contra 0,63 ms com `@>` (Bitmap Index Scan).
  //
  // Então o filtro `?cf[slug]=valor` fica no Prisma tipado e PAGA a varredura,
  // porque ele se soma a vista, status, localização, busca, ordenação e paginação
  // num `where` só (ver `asset-filters.helper.ts`). O que desceu para `$queryRaw`
  // e usa este índice são as perguntas de tabela inteira, que não compõem com
  // nada: o 409 que impede apagar um campo em uso (D64) e o contador do D61
  // (`count-assets-with-field.usecase.ts`).
  //
  // Ele NÃO faz nada por `ORDER BY customFields->>'x'`, nem por faixa, nem por
  // `ILIKE` — por isso campo customizado não entra em `ASSET_SORTABLE` nesta
  // fase, e a F10 herda o número medido em vez de uma promessa.
  @@map("assets")
}

// ============================================================================
// POSSE E RESPONSABILIDADE — docs/referencia/modelo-de-posse.md (D14, D15, D16)
// ============================================================================

// Para QUEM um ativo foi entregue.
//
// Polimórfico como no Snipe-IT — pessoa, outro ativo ou localização —, com uma
// diferença que o Snipe-IT não tem: quando o alvo é `LOCATION`, os responsáveis
// são os OCUPANTES daquele local, que podem ser vários e em turnos diferentes
// (`LocationOccupant`). É o que permite a Mesa 1 ser da Laura de manhã e da Ana
// à tarde sem o ativo precisar apontar para duas pessoas.
enum AssignmentTarget {
  USER
  ASSET
  LOCATION
}

// Uma linha por entrega. `checkinAt` nulo = posse ABERTA (a atual).
//
// O histórico NUNCA é apagado: a devolução preenche `checkinAt`, não deleta a
// linha. É o mesmo princípio do `AccessoryCheckout` da F5 e do `ActivityLog`.
//
// UMA aberta por ativo, garantida por índice único PARCIAL criado na migration
// (`WHERE "checkinAt" IS NULL`) — regra do banco, não da aplicação, pelo mesmo
// motivo de `assets.assetTag`: o esquecimento deixa de ser possível.
//
// Esse índice é também a alavanca da decisão: o dia que N detentores simultâneos
// for necessário, derrubar o índice é a mudança — não reescrever a camada.
model Assignment {
  id      String @id @default(uuid()) @db.Uuid
  assetId String @db.Uuid

  // Discriminante + três FKs nuláveis. A coerência entre o tipo e qual FK está
  // preenchida é validada no use-case (`assertAlvoCoerente`): CHECK constraint
  // não é expressável no schema do Prisma e ficaria invisível aqui.
  targetType       AssignmentTarget
  targetUserId     String?          @db.Uuid
  targetAssetId    String?          @db.Uuid
  targetLocationId String?          @db.Uuid

  checkoutAt        DateTime  @default(now())
  expectedCheckinAt DateTime?
  checkinAt         DateTime?

  checkoutNotes String?
  checkinNotes  String?

  // Quem operou a entrega e a devolução. Nulável e SEM relação com `User` pelo
  // mesmo motivo do `ActivityLog.actorId`: autenticação é a F3, e esperar por
  // ela significaria perder o registro de tudo que rodar até lá.
  checkoutById String? @db.Uuid
  checkinById  String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade no ativo dono da posse: apagar o ativo de verdade leva o histórico
  // dele junto. Restrict nos ALVOS: não se apaga uma pessoa, um local ou um
  // ativo que ainda segura alguma coisa — é o 409 por uso do catálogo.
  asset          Asset     @relation("AssignmentAsset", fields: [assetId], references: [id], onDelete: Cascade)
  targetUser     User?     @relation(fields: [targetUserId], references: [id], onDelete: Restrict)
  targetAsset    Asset?    @relation("AssignmentTargetAsset", fields: [targetAssetId], references: [id], onDelete: Restrict)
  targetLocation Location? @relation(fields: [targetLocationId], references: [id], onDelete: Restrict)


  @@index([assetId, checkinAt])
  @@index([targetUserId, checkinAt])
  @@index([targetLocationId, checkinAt])
  @@index([targetAssetId, checkinAt])
  @@map("assignments")
}


model LocationOccupant {
  id         String @id @default(uuid()) @db.Uuid
  locationId String @db.Uuid
  userId     String @db.Uuid

  // Texto livre de propósito: "Manhã", "Tarde", "12x36 A". Enum engessaria
  // escalas reais e faixa de horário seria agenda, não inventário (D15).
  shift String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  // A mesma pessoa não ocupa o mesmo posto duas vezes ao mesmo tempo: índice
  // único PARCIAL (`WHERE "endedAt" IS NULL`) criado na migration.
  @@index([locationId, endedAt])
  @@index([userId, endedAt])
  @@map("location_occupants")
}

// Configuração global do sistema — uma linha só.
//
// O id é fixo (`singleton`) em vez de uuid: é o que impede uma segunda linha de
// existir sem precisar de trigger nem de constraint de contagem.
// ============================================================================
// ARQUIVO — docs/FECHAMENTO-F2-F4-PLANO-ITAM.md (D83, D84)
// ============================================================================

// Anexo de um ativo: nota fiscal, contrato, foto, laudo.
//
// A LINHA mora aqui; os BYTES moram no `UPLOAD_DIR` e quem os grava é
// `server/core/storage/` (D83) — que não sabe o que é um anexo, e por isso
// serve também à assinatura e ao PDF do termo, que NÃO são anexos de ativo.
//
// FK DIRETA PARA `Asset`, não polimórfica. Quando licença (F6) e manutenção
// (F8) quiserem anexo, é uma coluna nulável a mais e um discriminante — o
// padrão do `Assignment`, aditivo. Nascer polimórfico agora é pagar
// complexidade por dois donos que não existem.
//
// `onDelete: Cascade` é o DELETE FÍSICO, que hoje não tem rota: o ativo tem
// soft delete, e mandá-lo para a lixeira NÃO apaga arquivo nenhum — restaurar
// tem que devolver a nota fiscal junto.
model Attachment {
  id      String @id @default(uuid()) @db.Uuid
  assetId String @db.Uuid

  // O nome NO DISCO: uuid + extensão da allowlist de MIME. Nunca o nome que o
  // cliente mandou — `../../` num nome de arquivo é o ataque mais velho que
  // existe, e `path.join` não protege sozinho.
  path String

  // O nome que a PESSOA deu, só para exibir e para o download nomear o arquivo.
  originalName String
  mimeType     String
  sizeBytes    Int

  // Quem subiu. Nasce PREENCHIDO — ao contrário do que a Etapa G da F2 previa,
  // porque quando ela foi escrita a F3 não existia. Sem FK, como `createdById`.
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("attachments")
}



model JobRun {
  /// 'lembrete-de-atraso', 'alertas-diarios', 'sync-ldap'.
  name      String    @id
  lastRunAt DateTime?
  updatedAt DateTime  @updatedAt

  @@map("job_runs")
}

model AppSetting {
  id String @id @default("singleton")

  // Etiqueta automática: ATV- + 00001. `assetTagNext` é incrementado PRIMEIRO e
  // o valor devolvido é o que vira etiqueta — ler-e-depois-incrementar colide
  // em READ COMMITTED.
  assetTagPrefix   String @default("ATV-")
  assetTagZerofill Int    @default(5)
  assetTagNext     Int    @default(1)

  // QUAL rótulo a entrega e a devolução aplicam.
  //
  // Vazios, vale o comportamento que já existia: o PRIMEIRO status do tipo
  // (`IN_USE` na entrega, `DEPLOYABLE` na devolução), ordenado por nome. Isso
  // funciona com os 8 rótulos do seed e vira loteria quando alguém cadastra
  // "Em uso — home office" e "Em uso — escritório": a escolha passa a depender
  // da ordem alfabética, e ninguém escreveu isso em lugar nenhum.
  checkoutStatusId String? @db.Uuid
  checkinStatusId  String? @db.Uuid

  // Texto conhecido, cifrado. Decifrado no boot: chave trocada derruba o
  // processo em vez de só falhar semanas depois (F6, D91 — core/crypto/canary.ts).
  cryptoCanary String?

  // ── OS BOTÕES DA DESCOBERTA (F7) ─────────────────────────────────────────
  //
  // Moram no singleton que já existe, e não numa tabela de configuração nova:
  // são cinco valores, não um domínio.
  //
  // `SUGGEST` é o padrão e isso é o D51: em `ON`, a primeira VM de teste que
  // alguém subir vira patrimônio — e consome uma etiqueta do contador, que o
  // `nextAssetTag()` nunca devolve. O estrago não é a linha a mais, é a
  // sequência de etiquetas furada para sempre.
  discoveryMode DiscoveryMode @default(SUGGEST)

  /// Ativo sem contato de agente há mais que isto é FANTASMA.
  ghostDays   Int @default(30)
  /// Máquina sem cadastro vista há mais que isto é SHADOW IT.
  shadowHours Int @default(24)

  /// Expurgo do `EndpointUserDaily` (D49): dado de pessoa, retenção curta.
  userDailyRetentionDays Int @default(90)

  /// Contas que a detecção de posto compartilhado IGNORA — o técnico de TI que
  /// loga em 40 máquinas para dar suporte, a conta de serviço (D101).
  ///
  /// NASCE VAZIA. Preencher com palpites (`admin`, `administrator`) esconderia
  /// um administrador que é uma pessoa de verdade usando a máquina dela.
  ignoredUserKeys String[] @default([])

  // ── O CICLO DE VIDA E OS ALERTAS (F8) ────────────────────────────────────
  //
  // Moram aqui pelo mesmo motivo dos cinco botões da descoberta: são valores de
  // configuração, não um domínio. E moram no BANCO, e não no `.env`, porque
  // destinatário e limiar mudam sem deploy — o que fica no ambiente é o
  // TRANSPORTE (`SMTP_URL`, `MAIL_FROM`), que é segredo (D57).
  //
  // NÃO EXISTE `lastAlertRunAt` AQUI, e isso é o D79: a janela de execução de
  // cada job é uma LINHA em `job_runs`, com o nome do job como chave. Uma coluna
  // aqui seria disputada pelo lembrete de atraso da F4 e pelos alertas desta
  // fase — o segundo a acordar receberia `count: 0`, leria como "já rodou hoje" e
  // nunca executaria, todo dia, sem erro e sem log.

  /// Desligado, o job toma a janela e não faz nada. Nem grava, nem envia.

  /// Quem recebe o e-mail. VAZIA por padrão: endereço chutado é e-mail perdido.

  /// Slack, Teams, o que aceitar um POST. Validado em TODO envio (D126): só
  /// `https`, e nunca host interno — a URL vem do banco e a requisição sai do
  /// servidor, o que é SSRF pelo desenho.

  /// Antecedência dos avisos de prazo, em dias.
  warrantyAlertDays Int @default(30)
  eolAlertDays      Int @default(60)

  /// Manutenção aberta há mais que isto vira alerta. É o que dá `dueAt` a um
  /// fato que não tem data-alvo: `completionDate` é nulo justamente por ela
  /// estar aberta (D125).

  /// De quanto em quanto tempo cada ativo deve ser conferido, e com quanta
  /// antecedência o relatório avisa. O corte é calculado a partir daqui a cada
  /// consulta — nunca gravado em coluna (D53).

  /// A HORA local em que a rodada diária pode ser tomada (0–23), e o FUSO que
  /// decide o que é "hoje" (D123).
  ///
  /// Sem `alertHour`, a janela do dia é tomada pelo primeiro tick depois da
  /// meia-noite e o campo na tela não muda nada. Sem `timezone`, "hoje" é o dia
  /// do PROCESSO — que roda em UTC em produção e no fuso de quem desenvolve na
  /// máquina local, então a mesma configuração produz dois comportamentos.
  timezone  String @default("America/Sao_Paulo")

  // ── A IDENTIDADE, O FORMATO E O BACKUP (F10, D65) ────────────────────────
  //
  // O TODO pedia um "`Setting` singleton" novo. Ele já existe — é esta tabela,
  // desde a F1, e é onde o `assetTagNext` mora. Uma segunda tabela de
  // configuração global seria duas linhas respondendo à mesma pergunta, e a
  // primeira dúvida de quem chegasse depois seria "em qual delas eu escrevo?".
  //
  // MORA NO BANCO e não no `.env` pelo mesmo motivo dos limiares de alerta
  // (D57): marca, moeda e formato de data mudam sem deploy. O que fica no
  // ambiente é o que é SEGREDO ou é do processo — `SMTP_URL`, `BACKUP_ENABLED`,
  // `BACKUP_DIR`.

  /// Aparece no topo da tela, no termo de entrega e no rodapé da etiqueta.
  companyName String @default("Minha Empresa")

  /// Caminhos RELATIVOS dentro do `UPLOAD_DIR`, nunca URL: o arquivo sai por
  /// rota autenticada, como todo anexo (D84). Guardar URL absoluta aqui faria
  /// a logo quebrar no dia em que o domínio mudasse.
  logoPath    String?
  faviconPath String?

  /// A cor de destaque, em `#rrggbb` — vai para `style`, porque o Tailwind não
  /// gera classe a partir de string de runtime. O padrão é a cor que a
  /// interface já usa hoje (`--color-text-primary`): ligar o botão não muda
  /// nada até alguém escolher outra.
  primaryColor String @default("#ededed")

  /// Como NÚMERO e DATA são escritos na tela. Não valem para o CSV: lá a regra
  /// é ponto decimal e `YYYY-MM-DD`, porque o export é a entrada do importador
  /// e um `1.234,50` não sobrevive ao round-trip (D69).
  locale     String @default("pt-BR")
  dateFormat String @default("DD/MM/YYYY")
  currency   String @default("BRL")

  /// O delimitador que o export escreve e que o import OFERECE como padrão —
  /// o Excel em português salva com `;`. No import ele é detectado na linha de
  /// cabeçalho; aqui é só o palpite inicial.
  csvDelimiter String @default(";")

  /// Quantos dias de dump ficam em disco. O expurgo é explícito e tem nome
  /// (`prune-backups`): sem ele, "backup pela interface" é uma forma lenta de
  /// encher o volume do servidor até o Postgres não conseguir mais escrever.

  // ── O LAYOUT DA ETIQUETA (F10, Etapa G) ──────────────────────────────────
  //
  // MORA AQUI, e não numa tabela de "modelos de etiqueta": é UM layout por
  // instalação, porque é uma folha de etiquetas adesivas que a empresa compra
  // — e ela compra uma. Uma tabela de layouts seria a tela de escolher entre
  // linhas que ninguém cadastrou.
  //
  // AS MEDIDAS SÃO EM MILÍMETROS, e não em pontos: quem configura isto está com
  // a embalagem da folha na mão, e a embalagem fala em milímetros. A conversão
  // para pontos PostScript (72 por polegada) é do renderizador.

  /// `A4` ou `LETTER`. O PDF é gerado no tamanho EXATO da página — a impressora
  /// que "ajusta à página" desalinha a folha inteira, e a tela avisa isso.

  /// A grade. 3×8 é a folha de etiqueta mais comum no Brasil (Pimaco 6081).

  /// As margens da folha e o espaço ENTRE etiquetas, em mm.

  /// O que vai impresso em cada etiqueta, na ordem. Allowlist no servidor
  /// (`label-fields.helper.ts`): token fora dela é 422.

  /// O QR leva a URL da tela do ativo; o código de barras leva a ETIQUETA (D70).
  /// São dois leitores diferentes: a câmera do celular abre link, o leitor de
  /// mão digita texto num campo.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ============================================================================
// ESTOQUE — os três tipos que TÊM QUANTIDADE (docs/historico/fase-05-estoque.md)
//
// A régua contra o `Asset`: **tem etiqueta própria → é `Asset`**. Lá uma linha
// é um equipamento com patrimônio e série; aqui uma linha é N unidades
// INTERCAMBIÁVEIS, e o que separa os três é o que acontece quando uma sai:
//
//   `Accessory`   sai para pessoa OU POSTO, e volta  → `checkedInAt`
//   `Consumable`  sai para pessoa e NÃO volta        → não existe coluna
//   `Component`   sai para DENTRO de um ativo, volta → `detachedAt`, parcial
//
// A dock tem patrimônio, então é `Asset` com `Assignment` de alvo `ASSET` (F4).
// O pente de RAM não tem, então é `Component`. O mouse avulso da gaveta não
// tem, então é `Accessory`.
//
// NENHUMA DAS TRÊS TEM COLUNA DE SALDO, e isso é o D34. `qty` é *quanto
// entrou*; o disponível é `COUNT`/`SUM` sobre as linhas de saída, calculado num
// helper só. Uma coluna `qtyAvailable` mantida por decremento pode DIVERGIR das
// linhas — basta um INSERT que não passe pelo decremento — e a partir daí ela
// mente para sempre, porque ela *é* a resposta: não existe ninguém para
// discordar dela. É o D16 uma camada abaixo.
//
// OS TRÊS TÊM LIXEIRA, e aqui o D8 não se aplica (D36). O vazamento que o D8
// evitou é o de um registro apagado aparecendo como valor ATUAL de outra linha;
// aqui a leitura aninhada é de HISTÓRICO — o nome do acessório na linha de
// consumo de março — e mostrar o item apagado ali é o certo. O delete real
// levaria junto o histórico de consumo, a única coisa da fase que não se
// reconstrói.
// ============================================================================

// Para QUEM um acessório foi entregue.
//
// Só `USER` e `LOCATION`. `ASSET` NÃO entra: o que vai para dentro de um ativo
// é `Component`, que tem tabela própria e quantidade por instalação. Um enum
// que admite valor sem significado é um enum que um dia vai guardar um — foi
// assim que a auditoria da F1 achou "Em Uso" tipado `DEPLOYABLE`.
enum AccessoryTarget {
  USER
  LOCATION
}

// O que é entregue e VOLTA: mouse, teclado, headset sem patrimônio.
//
// A novidade sobre o Snipe-IT está no alvo: entregar 5 mouses à Mesa 1 é o caso
// real do docs/referencia/modelo-de-posse.md, e forçar a escolha de uma pessoa faria o
// acessório mentir do mesmo jeito que `assignedToId` mentiria (D17).
model Accessory {
  id   String @id @default(uuid()) @db.Uuid
  name String

  // QUANTO ENTROU — não quanto sobra. Só muda por `adjust-quantity`, na mesma
  // transação que grava o `StockLog`; por isso a chave NÃO existe no schema de
  // edição (`strictObject` devolve 422 a chave desconhecida, e não declarar é a
  // defesa — o mesmo princípio do D37).
  qty Int

  // Piso do alerta de estoque baixo. Nulo = não alerta.
  minQty      Int?
  modelNumber String?

  categoryId     String  @db.Uuid
  manufacturerId String? @db.Uuid
  supplierId     String? @db.Uuid
  // ONDE o estoque mora (o almoxarifado). NÃO é para quem foi entregue.
  locationId     String? @db.Uuid

  orderNumber  String?
  purchaseDate DateTime?
  // Decimal, nunca Float. Sai no JSON como STRING ("1234.5").
  purchaseCost Decimal?  @db.Decimal(12, 2)

  notes String?

  // Autoria (D26): a tela de detalhe mostra, e a alternativa era consultar o
  // `ActivityLog` por linha. Sem FK, como em `Asset` — é carimbo, não vínculo.
  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Restrict no catálogo: é o 409 por uso, e a FK é a rede embaixo dele.
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  checkouts AccessoryCheckout[]

  // `name` NÃO é @unique aqui: a unicidade é índice PARCIAL
  // (`WHERE "deletedAt" IS NULL`) na migration — o `unique_undeleted` de novo.
  // Com @unique comum, um acessório na lixeira travaria para sempre o
  // recadastro do mesmo nome.
  @@index([deletedAt])
  @@index([categoryId])
  @@map("accessories")
}

// UMA LINHA POR UNIDADE ENTREGUE. Devolver preenche `checkedInAt` e NUNCA
// apaga a linha — mesmo princípio do `Assignment` e do `ActivityLog`.
//
// Entregar a um posto vale UMA unidade, qualquer que seja o número de ocupantes
// (D33): o saldo do almoxarifado não pode depender da escala do RH. Quem
// responde por ela são os ocupantes abertos daquele posto, resolvidos na
// leitura — e posto sem ocupante resolve para `[]`, que é o *posto vago* do
// docs/referencia/modelo-de-posse.md aplicado ao estoque, não um bug.
model AccessoryCheckout {
  id          String @id @default(uuid()) @db.Uuid
  accessoryId String @db.Uuid

  // Discriminante + duas FKs nuláveis, como no `Assignment`. A diferença é que
  // aqui a coerência ENTRE OS DOIS é CHECK constraint do banco, escrita à mão na
  // migration (`accessory_checkout_alvo_xor`): o Prisma não a expressa, mas o
  // Postgres a aplica — e `targetType: 'USER'` com `targetLocationId`
  // preenchido deixa de ser uma linha que o banco aceita em silêncio.
  targetType       AccessoryTarget
  targetUserId     String?         @db.Uuid
  targetLocationId String?         @db.Uuid

  checkedOutAt      DateTime  @default(now())
  expectedCheckinAt DateTime?
  /// Nulo = unidade FORA do estoque. É o que o saldo conta.
  checkedInAt       DateTime?

  checkoutNotes String?
  checkinNotes  String?

  checkoutById String? @db.Uuid
  checkinById  String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade no item dono da saída; Restrict nos ALVOS: não se apaga uma pessoa
  // nem um posto que ainda segura unidade — é o 409 por uso do catálogo.
  accessory      Accessory @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  targetUser     User?     @relation(fields: [targetUserId], references: [id], onDelete: Restrict)
  targetLocation Location? @relation(fields: [targetLocationId], references: [id], onDelete: Restrict)

  @@index([accessoryId, checkedInAt])
  @@index([targetUserId, checkedInAt])
  @@index([targetLocationId, checkedInAt])
  @@map("accessory_checkouts")
}

// O que sai e NÃO volta: resma de papel, toner, café.
model Consumable {
  id   String @id @default(uuid()) @db.Uuid
  name String

  qty         Int
  minQty      Int?
  modelNumber String?

  categoryId     String  @db.Uuid
  manufacturerId String? @db.Uuid
  supplierId     String? @db.Uuid
  locationId     String? @db.Uuid

  orderNumber  String?
  purchaseDate DateTime?
  purchaseCost Decimal?  @db.Decimal(12, 2)

  notes String?

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  checkouts ConsumableCheckout[]

  @@index([deletedAt])
  @@index([categoryId])
  @@map("consumables")
}

// O CONSUMO. Note o que NÃO existe aqui: coluna de fechamento (D37).
//
// A irreversibilidade é ESTRUTURAL, não uma regra a lembrar. A alternativa —
// aceitar `POST .../checkin` e responder 409 "consumível não volta" — põe a
// regra na memória de quem escreve o próximo use-case; sem coluna e sem rota, o
// checkin responde 404 do roteador e implementar a devolução passa a exigir uma
// migração, que é o tipo de mudança que alguém revisa. Mesmo princípio do D13:
// a segurança vem da AUSÊNCIA do nome.
model ConsumableCheckout {
  id           String @id @default(uuid()) @db.Uuid
  consumableId String @db.Uuid

  // Nulável e `SetNull`: apagar o cadastro não pode apagar o consumo de março,
  // que é linha de rateio e de orçamento.
  userId String? @db.Uuid

  // O NOME COPIADO NO ATO, pelo mesmo motivo do EULA do `Acceptance` (D29): o
  // consumo precisa continuar legível depois que a pessoa sai da empresa.
  userNameSnapshot String

  /// Quantas unidades saíram NESTA linha. Sem par de devolução — ver acima.
  qty        Int      @default(1)
  consumedAt DateTime @default(now())
  notes      String?

  consumedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  consumable Consumable @relation(fields: [consumableId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  // O `COUNT`/`SUM` desta tabela cresce para sempre: cada consumo é linha que
  // nunca fecha. Com este índice serve folgado à escala de um time interno; se
  // um dia não servir, a saída é linha de FECHAMENTO DE PERÍODO, não uma coluna
  // de saldo — coluna reabriria o D34.
  @@index([consumableId])
  @@index([userId])
  @@map("consumable_checkouts")
}

// O que vai para DENTRO de um ativo: pente de RAM, HD, placa.
model Component {
  id   String @id @default(uuid()) @db.Uuid
  name String

  qty         Int
  minQty      Int?
  modelNumber String?

  /// O único campo que os outros dois não têm. Um lote de pentes idênticos com
  /// uma série só é o caso comum da nota fiscal; série POR UNIDADE seria
  /// reinventar `Asset` — a régua está no topo desta seção.
  serial String?

  categoryId     String  @db.Uuid
  manufacturerId String? @db.Uuid
  supplierId     String? @db.Uuid
  locationId     String? @db.Uuid

  orderNumber  String?
  purchaseDate DateTime?
  purchaseCost Decimal?  @db.Decimal(12, 2)

  notes String?

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  instalacoes ComponentAsset[]

  @@index([deletedAt])
  @@index([categoryId])
  @@map("components")
}

// UMA LINHA POR INSTALAÇÃO, COM QUANTIDADE — a primeira ponte real entre
// estoque e ativo.
//
// DEVOLUÇÃO PARCIAL DIVIDE A LINHA (D38): retirar 2 de 4 pentes fecha a linha
// de 4 (`detachedAt = now()`) e abre uma com `assignedQty = 2`, que é o que
// CONTINUA instalado. Decrementar `assignedQty` na linha aberta seria mais
// curto e apagaria a resposta de "quantos pentes estavam nessa máquina em
// março?".
//
// O preço, declarado: lido cru, o histórico parece dizer "instalou 4, retirou
// 4, instalou 2". A aba rotula o par como *devolução parcial: 2 de 4*
// comparando a linha fechada com a sucessora — trabalho de apresentação, não de
// schema. A soma das linhas ABERTAS continua sendo o estado atual.
model ComponentAsset {
  id          String @id @default(uuid()) @db.Uuid
  componentId String @db.Uuid
  assetId     String @db.Uuid

  /// Quantas unidades DESTA linha estão instaladas. É o que o saldo soma.
  assignedQty Int

  attachedAt DateTime  @default(now())
  /// Nulo = ainda instalado.
  detachedAt DateTime?

  /// A observação da INSTALAÇÃO — por que a peça entrou.
  notes String?

  /// A observação da RETIRADA — por que a peça saiu.
  ///
  /// COLUNA PRÓPRIA, e não a mesma `notes`, pelo mesmo motivo do par
  /// `checkoutNotes`/`checkinNotes` do `AccessoryCheckout`: com uma só, a nota
  /// da saída SOBRESCREVE a da entrada, e "upgrade de 8 para 16 GB" some para
  /// sempre no dia em que alguém registra "2 pentes com defeito". A linha
  /// guarda DOIS eventos; duas observações é a forma que corresponde a isso.
  detachNotes String?

  /// A linha que esta SUCEDE numa retirada parcial (D38).
  ///
  /// Retirar 2 de 4 fecha a linha de 4 e abre uma de 2; a sucessora aponta aqui
  /// para a antecessora. É o que deixa a movimentação rotular o par como
  /// *"parcial: 2 de 4"* SEM ADIVINHAR POR DATA — o `attachedAt` da sucessora é
  /// igual ao `detachedAt` da fechada, e casar as duas por timestamp seria uma
  /// heurística que quebra no primeiro caminho que grave as datas de outro
  /// jeito.
  ///
  /// `@unique` porque uma linha fechada é sucedida NO MÁXIMO UMA VEZ: a divisão
  /// acontece no ato de fechar, e depois de fechada ela não se divide de novo.
  /// É essa unicidade que faz a relação ser 1-1 e a sucessora ser consultável
  /// pelo lado de cá.
  predecessorId String? @unique @db.Uuid

  attachedById String? @db.Uuid
  detachedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade no componente dono; Restrict no ATIVO: não se apaga de verdade um
  // ativo que ainda tem peça dentro. E o soft delete do ativo é recusado pelo
  // `deleteAsset`, porque o `Restrict` não alcança um `UPDATE deletedAt`.
  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  // A divisão da retirada parcial, como relação 1-1 consigo mesma. `SetNull` e
  // não `Cascade`: apagar a antecessora não pode levar junto o que CONTINUA
  // instalado — são unidades diferentes, e a sucessora é o estado atual.
  predecessor ComponentAsset? @relation("DivisaoDaInstalacao", fields: [predecessorId], references: [id], onDelete: SetNull)
  sucessora   ComponentAsset? @relation("DivisaoDaInstalacao")

  @@index([componentId, detachedAt])
  @@index([assetId, detachedAt])
  @@map("component_assets")
}

// ============================================================================
// MOVIMENTAÇÃO DE ESTOQUE — docs/historico/fase-05-estoque.md, Etapa D
// ============================================================================

enum StockItemType {
  ACCESSORY
  CONSUMABLE
  COMPONENT
}

// POR QUE A QUANTIDADE NOMINAL MUDOU — e só isso.
//
// Fechado de propósito, pelo D5: é campo de relatório, e texto livre viraria
// "compra", "Compra" e "comprado" na mesma coluna.
enum StockAdjustReason {
  /// Chegou nota: entrada nova no almoxarifado.
  COMPRA
  /// Saiu de volta para o fornecedor (troca, recusa de recebimento).
  DEVOLUCAO_FORNECEDOR
  /// Quebrou, vazou, estragou. A unidade existia e não existe mais.
  QUEBRA
  /// Sumiu. Diferente de QUEBRA: ninguém sabe onde está.
  PERDA
  /// A contagem física não batia com a nominal, e a física venceu.
  RECONTAGEM
  OUTRO
}

// O histórico de por que a QUANTIDADE NOMINAL mudou.
//
// ─────────────────────────────────────────────────────────────────────────────
// O QUE ELE NÃO RESPONDE, e isso é a decisão inteira: para ONDE a unidade foi.
//
// Isso já está em `accessory_checkouts`, `consumable_checkouts` e
// `component_assets` — com alvo, data e quem operou. Um `StockLog` que também
// registrasse as saídas seria uma segunda contagem do mesmo fato, e as duas
// divergiriam no primeiro caminho que esquecesse de escrever em uma delas. É o
// D34 visto do outro lado: a saída é LINHA, e o log é só sobre `qty`.
//
// A "movimentação completa" que a tela mostra é a UNIÃO das duas fontes na
// LEITURA (`list-item-movements.usecase.ts`), nunca uma terceira tabela que
// tentasse guardar as duas.
// ─────────────────────────────────────────────────────────────────────────────
//
// `itemId` é polimórfico e SEM FK, como o `ActivityLog.entityId`: o log é
// append-only e a integridade dele não pode depender do ciclo de vida da linha
// do item — inclusive porque o item pode ir para a lixeira e voltar.
model StockLog {
  id String @id @default(uuid()) @db.Uuid

  itemType StockItemType
  itemId   String        @db.Uuid

  /// Quanto foi SOMADO a `qty`. Negativo é baixa. Nunca o valor final: o valor
  /// final é ler-e-depois-escrever com outro nome, e duas recontagens
  /// simultâneas se sobrescreveriam sem erro.
  delta  Int
  reason StockAdjustReason
  notes  String?

  /// Quem ajustou. Nulável e sem FK, pelo mesmo motivo do `ActivityLog.actorId`.
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([itemType, itemId, createdAt])
  @@map("stock_logs")
}

// ============================================================================
// LICENÇAS DE SOFTWARE — docs/FASE-6-EXECUCAO-ITAM.md (D39–D94)
//
// O que a licença tem e o ativo não tem é ASSENTO: ela não é entregue, é
// consumida N vezes. Três decisões desenham as tabelas:
//
//   D40  o assento é MATERIALIZADO (uma linha, não um contador) — é o que se trava
//   D39  o assento vai para uma pessoa XOR um ativo, nunca para um posto
//   D42  a chave de produto é cifrada em repouso e mascarada na resposta
//
// Nenhuma coluna de saldo (livres é conta sobre as linhas, D92) e nenhuma
// coluna de status (é função das datas e de hoje, D44).
// ============================================================================

model License {
  // SEM `@default(uuid())`: o AAD da cifra é "licenses:productKey:<id>", então o
  // id precisa existir antes do INSERT (D91, create-license.usecase.ts).
  id   String @id @db.Uuid
  name String

  /// Assentos do contrato hoje. Invariante 11: COUNT(assentos sem retiredAt) = este número.
  seatsTotal Int

  /// `false` = assento devolvido QUEIMA e não volta ao contrato (D43).
  reassignable Boolean @default(true)
  /// Contrato de manutenção. Informativo e filtro — não tem efeito no inventário.
  maintained   Boolean @default(false)

  expirationDate  DateTime?
  /// Rescisão. Vence tudo: JÁ PASSADA, a licença é ENCERRADA mesmo com
  /// vencimento futuro. Data FUTURA ainda não encerra nada — o contrato vale
  /// até o dia marcado (`license-status.helper.ts` compara com hoje).
  terminationDate DateTime?

  licensedToName  String?
  licensedToEmail String?

  /// `enc:v1:<kid>:<iv>:<tag>:<ct>`. NUNCA em claro — sem chave de criptografia
  /// o campo é recusado com 422. Fora de `LICENSE_AUDITED` e de todo `select`
  /// de leitura; quem a lê é reveal-product-key.usecase.ts (D42).
  productKey String?

  /// Piso do alerta de assentos livres. Nulo = não alerta.
  minSeats Int?

  categoryId     String  @db.Uuid
  manufacturerId String? @db.Uuid
  supplierId     String? @db.Uuid

  orderNumber  String?
  purchaseDate DateTime?
  /// Decimal, nunca Float. Sai no JSON como STRING.
  purchaseCost Decimal?  @db.Decimal(12, 2)

  notes String?

  // Autoria (D26): sem FK, como em `Asset`.
  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  seats LicenseSeat[]

  /// Os pacotes de software que esta licença cobre. Vínculo explícito (D102).
  software LicenseSoftware[]

  // `name` não é @unique: a unicidade é índice PARCIAL na migration.
  @@index([deletedAt])
  @@index([categoryId])
  @@index([expirationDate])
  @@map("licenses")
}

// Uma linha por assento comprado — a unidade contável e travável (D40).
//
// NÃO tem `deletedAt`: a `softDeleteExtension` escopa todo model que tenha a
// coluna, e com lixeira o saldo pararia de enxergar ocupação aberta. Assento se
// aposenta, não some.
model LicenseSeat {
  id        String @id @default(uuid()) @db.Uuid
  licenseId String @db.Uuid

  /// Único por licença. Assento novo nasce com MAX+1, nunca COUNT+1 — a linha
  /// aposentada continua na tabela e a contagem colidiria.
  seatNumber Int

  /// QUEIMADO: devolvido numa licença não reatribuível. Perda de dinheiro.
  burnedAt  DateTime?
  /// APOSENTADO: o contrato encolheu. Mudança de contrato — relatório diferente (D43).
  retiredAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  license   License               @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  checkouts LicenseSeatCheckout[]

  @@unique([licenseId, seatNumber], map: "license_seats_numero")
  @@index([licenseId])
  @@map("license_seats")
}

// A ocupação. Devolver preenche `checkinAt` e NUNCA apaga a linha — mesmo
// princípio do `Assignment` e do `AccessoryCheckout` (D40).
model LicenseSeatCheckout {
  id     String @id @default(uuid()) @db.Uuid
  seatId String @db.Uuid

  // XOR garantido por CHECK na migration (`license_seat_alvo_xor`). Sem
  // discriminante: com dois alvos, a FK preenchida já diz qual é.
  assignedUserId  String? @db.Uuid
  assignedAssetId String? @db.Uuid

  checkoutAt DateTime  @default(now())
  /// Nulo = assento OCUPADO. É o que a conta de livres desconta.
  checkinAt  DateTime?

  checkoutNotes String?
  checkinNotes  String?

  checkoutById String? @db.Uuid
  checkinById  String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade no assento; Restrict nos alvos — é a rede embaixo do 409 do desligamento.
  seat          LicenseSeat @relation(fields: [seatId], references: [id], onDelete: Cascade)
  assignedUser  User?       @relation(fields: [assignedUserId], references: [id], onDelete: Restrict)
  assignedAsset Asset?      @relation(fields: [assignedAssetId], references: [id], onDelete: Restrict)

  @@index([seatId, checkinAt])
  @@index([assignedUserId, checkinAt])
  @@index([assignedAssetId, checkinAt])
  @@map("license_seat_checkouts")
}

// ============================================================================
// CONVERGÊNCIA RMM × ITAM — docs/historico/fase-07-convergencia-rmm-itam.md (D45–D51, D95–D103)
//
// O `Endpoint` sabe o que a máquina É; o `Asset` sabe o que a empresa COMPROU e
// de quem cobra. Tudo aqui existe para ligar os dois SEM FUNDI-LOS (D45) e para
// transformar o que o agente OBSERVA em cadastro que uma pessoa CONFIRMA.
//
// A regra que atravessa a fase inteira: nada aqui escreve posse sozinho. A fila
// propõe, um humano aceita, e quem grava é o use-case da F4 — com o zod da
// borda, o ActivityLog e as invariantes 1, 2 e 4 que já existem.
// ============================================================================

/// O que o sistema faz quando descobre máquina sem cadastro. `SUGGEST` por
/// padrão, e o porquê está no D51.
enum DiscoveryMode {
  OFF
  SUGGEST
  ON
}

/// POR QUE o sistema acha que este endpoint é este ativo. O ponto de cada um
/// está em `helpers/match-cascade.helper.ts`, não aqui: pontuação é regra de
/// negócio e muda; o nome do sinal é o vocabulário e não muda.
enum MatchSignal {
  SERIAL
  UUID
  MAC
  HOSTNAME
}

/// O QUE a sugestão propõe. Uma fila para as cinco formas (D96) — o que elas
/// têm em comum é tudo o que dá trabalho (nascer de um job idempotente, não
/// duplicar, guardar evidência, ser aceita ou recusada, lembrar da recusa).
enum SuggestionKind {
  /// Este endpoint é este ativo.
  LINK
  /// Este endpoint é o MESMO que aquele outro: reimagem ou troca de placa.
  MERGE
  /// O ativo está com esta pessoa (a `Assignment` que falta).
  CHECKOUT
  /// A pessoa OCUPA o posto a que o ativo está entregue — o item que só existe
  /// por causa do modelo de posse (D47).
  OCCUPANCY
  /// Duas pessoas em turnos diferentes na mesma máquina: promover a posto (D48).
  SHARED_POST
}

enum SuggestionState {
  PENDING
  ACCEPTED
  REJECTED
  /// A evidência mudou e esta sugestão foi substituída por outra. Não é recusa:
  /// ninguém disse não, o mundo é que mudou.
  SUPERSEDED
}

// A FILA DE RECONCILIAÇÃO — uma tabela para as cinco formas de sugestão (D96).
//
// POR QUE UMA SÓ: cinco tabelas seriam cinco cópias do que é caro (idempotência,
// deduplicação, evidência, aceite, memória da recusa) para variar o que é
// barato (qual FK está preenchida). Invariante copiada é invariante que um dia
// diverge — o mesmo argumento que uniu os três tipos de estoque (D35) e as duas
// naturezas de `ApiToken` (D80).
//
// O PREÇO, DECLARADO: a coerência entre `kind` e qual FK está preenchida não é
// expressável no schema do Prisma. É validada no use-case, como o
// `assertAlvoCoerente` da `Assignment`.
model ReconciliationSuggestion {
  id   String         @id @default(uuid()) @db.Uuid
  kind SuggestionKind

  endpointId String @db.Uuid

  // Os alvos. Qual deles está preenchido depende do `kind`.
  assetId             String? @db.Uuid
  targetUserId        String? @db.Uuid
  targetLocationId    String? @db.Uuid
  mergeIntoEndpointId String? @db.Uuid

  /// 0 a 100. Só `LINK` e `MERGE` pontuam por sinal de hardware; as outras
  /// carregam a confiança do casamento de pessoa.
  score  Int
  signal MatchSignal?

  /// Turno inferido, quando a sugestão é de ocupação. Texto livre (D15): o
  /// helper propõe "Manhã" e a pessoa corrige para "12x36 A".
  shift String?

  /// O QUE o sistema viu — quais dias, quais horas, quantas amostras, qual
  /// serial. Vai para a tela: sugestão sem evidência visível é palpite, e
  /// ninguém deveria aceitar um palpite que reescreve o inventário.
  evidence Json

  /// sha256 da evidência normalizada. É o que separa "já me disseram não sobre
  /// ISTO" de "já me disseram não sobre este par, faça o que fizer" (D97).
  evidenceHash String

  state        SuggestionState @default(PENDING)
  resolvedAt   DateTime?
  /// Sem FK, como `ActivityLog.actorId`: é carimbo de quem decidiu, não vínculo.
  resolvedById String?         @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  endpoint       Endpoint  @relation("SugestaoDoEndpoint", fields: [endpointId], references: [id], onDelete: Cascade)
  asset          Asset?    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  targetUser     User?     @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  targetLocation Location? @relation(fields: [targetLocationId], references: [id], onDelete: Cascade)
  mergeInto      Endpoint? @relation("SugestaoDeMerge", fields: [mergeIntoEndpointId], references: [id], onDelete: Cascade)

  // O índice que impede a fila de empilhar (`sugestao_pendente_por_alvo`, com
  // COALESCE nas FKs nuláveis) é PARCIAL e nasce na migration escrita à mão.
  @@index([state, kind])
  @@index([endpointId, state])
  @@index([assetId])
  @@map("reconciliation_suggestions")
}

// QUEM ESTEVE LOGADO NESTA MÁQUINA, EM QUE DIA — agregado, nunca log de sessão.
//
// O D49 em tabela. Uma linha por handshake seria a mesma armadilha que o
// `AssetUsageDaily` evita: a consulta "quem usa essa máquina" varreria milhões
// de linhas. E, sendo dado de PESSOA, o formato certo é o menor que responde à
// pergunta — em que dias e em que faixa de hora, não um rastro minuto a minuto.
//
// O propósito é declarado (identificar posto e ocupante), a retenção é curta
// (`AppSetting.userDailyRetentionDays`, 90 dias) e o que sai daqui é SUGESTÃO
// para um humano. Não é medida de produtividade, e este sistema não se propõe a
// fazer isso.
model EndpointUserDaily {
  id         String @id @default(uuid()) @db.Uuid
  endpointId String @db.Uuid

  /// A chave normalizada: `DOMINIO\ana.silva` → `ana.silva`. Guardada mesmo
  /// quando não casa com ninguém — é ela que denuncia a conta de serviço que
  /// precisa entrar na allowlist.
  userKey String
  /// Preenchido quando o casamento foi inequívoco. Ambíguo = null (D46).
  userId  String? @db.Uuid

  day         DateTime @db.Date
  firstSeenAt DateTime
  lastSeenAt  DateTime
  samples     Int      @default(1)

  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // É O ÍNDICE que garante a agregação, não o `upsert` lembrar de acertar a
  // chave. Declarado aqui porque o Prisma o expressa — os PARCIAIS (`WHERE …`)
  // é que moram só no SQL, e a diferença é a nota do model `Location`.
  @@unique([endpointId, userKey, day])
  @@index([endpointId, day])
  @@index([userId, day])
  @@map("endpoint_user_daily")
}

// MUDANÇA DE HARDWARE DETECTADA — trocou o HD, tiraram pente de RAM.
//
// Detectada, não digitada: a diferença com o `ActivityLog` é essa. Lá a linha
// tem ator e diz o que alguém FEZ; aqui não tem ator nenhum e diz o que o mundo
// mudou sem avisar. Espremer isto no ActivityLog daria `actorId` nulo em toda
// linha — e o D23 existe justamente para que ator nulo signifique alguma coisa.
model AssetChange {
  id         String  @id @default(uuid()) @db.Uuid
  assetId    String  @db.Uuid
  endpointId String? @db.Uuid

  /// O nome do campo como o usuário o vê: "RAM total", "Disco", "Modelo".
  field    String
  oldValue String?
  newValue String

  detectedAt DateTime @default(now())

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  endpoint Endpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([assetId, detectedAt])
  @@map("asset_changes")
}

// O CATÁLOGO DE SOFTWARE NORMALIZADO — o fim do `installedSoftware` write-only.
//
// Até a F7 o JSON do handshake era gravado e NUNCA lido por nada (três
// ocorrências no código, todas de escrita). Aqui ele vira duas tabelas que
// respondem perguntas.
model SoftwarePackage {
  id String @id @default(uuid()) @db.Uuid

  name      String
  version   String
  publisher String?

  /// A CHAVE É DERIVADA, e isso é o D100.
  ///
  /// `@@unique([name, version, publisher])` NÃO serve: em Postgres dois `NULL`
  /// não são iguais dentro de um índice único, então a tupla com `publisher`
  /// nulo — que é comum — não deduplica. O catálogo ganharia uma linha nova por
  /// máquina, por handshake, e a conformidade contaria como diferentes
  /// instalações que são a mesma.
  ///
  /// Formato: `nome|versão|fabricante ?? ''`, tudo em minúsculas.
  normalizedKey String @unique

  createdAt DateTime @default(now())

  installations SoftwareInstallation[]
  licenses      LicenseSoftware[]

  @@index([name])
  @@map("software_packages")
}

// O software visto NESTA máquina. `removedAt` preenchido = desinstalado —
// a linha fica, pelo mesmo princípio do `Assignment` e do `LicenseSeatCheckout`.
model SoftwareInstallation {
  id         String @id @default(uuid()) @db.Uuid
  endpointId String @db.Uuid
  packageId  String @db.Uuid

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  removedAt   DateTime?

  endpoint Endpoint        @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  package  SoftwarePackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  /// Uma linha por (máquina, pacote): o job reencontra a instalação e atualiza
  /// `lastSeenAt`, em vez de inserir de novo a cada handshake.
  @@unique([endpointId, packageId])
  @@index([endpointId, removedAt])
  @@index([packageId, removedAt])
  @@map("software_installations")
}

// A PONTE LICENÇA ↔ PACOTE — explícita, nunca por semelhança de nome (D102).
//
// "Office 365 E3" no contrato é "Microsoft 365 Apps for enterprise" no Programas
// e Recursos; "Adobe Acrobat Pro" convive com "Adobe Acrobat (64-bit)" e com o
// Reader, que é grátis. Casamento aproximado erra nos dois sentidos, e os dois
// erros são caros: um falso "instalado sem licença" manda comprar assento que já
// existe; um falso "coberto" entrega auditoria de fornecedor com resposta errada
// — que é exatamente a pergunta que o módulo de licença existe para responder
// valendo dinheiro.
//
// Um vínculo explícito é trabalho humano uma vez por licença, e é o único que
// alguém consegue CONFERIR.
model LicenseSoftware {
  id        String @id @default(uuid()) @db.Uuid
  licenseId String @db.Uuid
  packageId String @db.Uuid

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  license License         @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  package SoftwarePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([licenseId, packageId])
  @@index([packageId])
  @@map("license_software")
}

// ATIVO OCIOSO — quanto a máquina foi realmente usada, agregado por dia.
//
// Mesmo motivo do D49: sem agregação, "quem não usa este notebook há 30 dias"
// varre milhões de linhas de telemetria. E cruzado com o `postoVago` que o
// `resolverResponsaveis()` já devolve, isto separa "ninguém USA" de "ninguém
// RESPONDE" — duas conversas diferentes, com duas pessoas diferentes.
model AssetUsageDaily {
  id      String   @id @default(uuid()) @db.Uuid
  assetId String   @db.Uuid
  day     DateTime @db.Date

  /// Minutos com sinal de uso no dia, estimados pelas amostras de telemetria.
  activeMinutes Int @default(0)
  samples       Int @default(0)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, day])
  @@index([assetId, day])
  @@map("asset_usage_daily")
}












