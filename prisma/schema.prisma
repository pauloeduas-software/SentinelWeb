generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A máquina descoberta pelo Agente Sentinel — o lado RMM.
//
// Chamava-se `Asset` até a Fase 1. O nome foi liberado para o ativo do ITAM, que
// é o `Asset` do vocabulário do Snipe-IT. Aqui nenhuma coluna pode voltar a se
// chamar `status`, `lastSeen` ou `hwid` do outro lado: é essa ausência que faz o
// compilador barrar uma query do RMM que aponte para a tabela errada
// (docs/historico/fase-01-catalogo-e-ativo.md, D13).
model Endpoint {
  id       String @id @default(uuid()) @db.Uuid
  hwid     String @unique
  hostname String

  osVersion String

  // O EIXO DO AGENTE, e só ele. Enum desde a F7: era `String` livre, e o que
  // impedia `status = "Em uso"` de entrar aqui era a boa vontade de quem
  // escrevesse a query. O ciclo de vida do ativo é `StatusLabel`, outra tabela,
  // outro eixo (docs/historico/fase-07-convergencia-rmm-itam.md, D98).
  //
  // DOIS VALORES, e não os três que o TODO pedia: `NEVER_SEEN` seria um valor
  // que NENHUMA linha desta tabela pode ter, porque a linha nasce de um
  // handshake. "Cadastrado e nunca visto" é pergunta do ATIVO, e quem responde é
  // `Asset.lastSeenByAgentAt` no painel de cobertura.
  status   AgentStatus @default(ONLINE)
  lastSeen DateTime    @default(now())

  cpuModel   String?
  localIp    String?
  macAddress String?

  // ── IDENTIDADE COLETADA (F7, Etapa A) ────────────────────────────────────
  // Tudo nulável: o agente vive fora deste repositório e o rollout leva
  // semanas. Máquina que não manda serial não pontua por serial — não vira erro.
  biosSerial    String?
  systemUuid    String?
  manufacturer  String?
  /// `hardwareModel`, nunca `model`: `endpoint.model` lê-se como a relação de
  /// catálogo do ativo, e o compilador não pegaria a confusão (D13).
  hardwareModel String?
  chassisType   String?

  // SPECS COLETADAS — e elas moram AQUI, não em `assets`.
  //
  // O item do TODO pedia "specs de hardware como atributo do ativo". O que ele
  // queria de verdade era que o dado parasse de sumir no expurgo da telemetria,
  // e coluna nesta tabela resolve isso. Copiá-las para `assets` criaria uma
  // segunda fonte de verdade sobre a MESMA máquina, com um detalhe que a torna
  // pior que as outras: as duas podem divergir com razão (o pente foi trocado) e
  // ninguém saberia qual está certa. É o D16 uma camada abaixo.
  ramTotalBytes  BigInt?
  diskTotalBytes BigInt?

  /// Triagem do Shadow IT: máquina vista pelo agente e sem cadastro.
  reviewState ReviewState @default(UNREVIEWED)

  // ── O VÍNCULO COM O PATRIMÔNIO (D45) ─────────────────────────────────────
  //
  // A FK mora AQUI, e não em `assets`, por duas razões. A maioria dos ativos
  // nunca terá agente (monitor, cadeira, cabo, switch): no outro lado a coluna
  // ficaria nula na esmagadora maioria das linhas. E este é o lado que a
  // reconciliação ESCREVE.
  //
  // `@unique` garante o 1:1 sem tabela de junção. `SetNull` garante que apagar
  // um ativo não leve junto a telemetria da máquina — mas note que ele desfaz o
  // vínculo EM SILÊNCIO, e é por isso que o `unlink` tem linha no ActivityLog.
  assetId String? @unique @db.Uuid
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  telemetries Telemetry[]
  suggestions ReconciliationSuggestion[] @relation("SugestaoDoEndpoint")
  changes     AssetChange[]

  @@index([assetId])
  @@index([reviewState])
  @@map("endpoints")
}

// O eixo do AGENTE. Ver a nota em `Endpoint.status` para por que são dois
// valores e não três (D98).
enum AgentStatus {
  ONLINE
  OFFLINE
}

// A triagem do Shadow IT: máquina que o agente vê e o cadastro não conhece.
// `UNREVIEWED` é o estado de quem acabou de aparecer — a fila de trabalho.
enum ReviewState {
  UNREVIEWED
  ALLOWED
  BLOCKED
}

model Telemetry {
  id           String   @id @default(uuid()) @db.Uuid
  endpointId   String   @db.Uuid
  cpuUsage     Float
  ramTotal     BigInt
  ramUsed      BigInt
  timestamp    DateTime @default(now())
  disks        Json?
  network      Json?
  topProcesses Json?
  endpoint     Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@map("telemetries")
}

/// Os três papéis da autorização (D148). A ordem do enum é a hierarquia, e a
/// comparação mora em `access/helpers/papel.ts` — nunca num `indexOf` por fora.
enum Papel {
  USUARIO
  TECNICO
  ADMIN
}

model User {
  id    String @id @default(uuid()) @db.Uuid
  name  String
  email String

  // AUTENTICAÇÃO (F3). Nulável porque a base nasceu sem login: um colaborador
  // cadastrado para receber equipamento não precisa de acesso ao sistema, e
  // exigir senha de todo mundo tornaria a carga inicial impossível.
  //
  // `username` NÃO é @unique aqui: a unicidade é índice PARCIAL
  // (`WHERE deleted_at IS NULL`) na migration, o mesmo caso de `email` — um
  // usuário na lixeira travaria para sempre o recadastro do mesmo login.
  username     String?
  passwordHash String?

  // Bloqueio por tentativa. `lockedUntil` no futuro recusa o login mesmo com a
  // senha certa; quem zera os dois é o login bem-sucedido.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // A GERAÇÃO DA SESSÃO — o que faz trocar a senha DERRUBAR quem já está dentro.
  //
  // O buraco que isto fecha: a releitura por requisição
  // (`current-user.usecase.ts`) mata a sessão de quem foi apagado ou desligado,
  // mas NÃO a de quem continua sendo um usuário válido. Então quem roubasse o
  // cookie seguia operando por até 8 horas mesmo DEPOIS de a vítima trocar a
  // senha — que é justamente o que a vítima faz ao desconfiar.
  //
  // O número vai assinado dentro do JWT e é conferido contra esta coluna a cada
  // requisição: incrementar aqui invalida, de uma vez, todo token emitido antes
  // — sem tabela de sessão e sem lista de revogação.
  tokenVersion Int @default(0)

  // Último login bem-sucedido. Não é enfeite de perfil: em inventário, "quem
  // ainda usa o sistema" é a pergunta que antecede a limpeza de acessos.
  lastLoginAt DateTime?

  // ─────────────────────────────────────────────────────────────────────────
  // IDENTIDADE DO COLABORADOR (F11, Etapa E).
  //
  // `employeeNumber` tem unicidade por índice PARCIAL (`WHERE "deletedAt" IS
  // NULL`) na migration, o mesmo caso de `email` e `username`: uma matrícula na
  // lixeira travaria para sempre o recadastro da mesma pessoa.
  //
  // `firstName`/`lastName` NÃO EXISTEM: `name` já é o campo canônico, dividi-lo
  // exige um backfill que adivinha onde termina o nome em "Maria da Silva
  // Souza", e um campo que só existe para ser recomposto na exibição é duas
  // fontes de verdade para o mesmo dado.
  employeeNumber String?
  jobTitle       String?
  phone          String?
  address        String?

  /// Admissão. Não é `createdAt`: a pessoa trabalha aqui desde antes do sistema.
  hiredAt DateTime?

  // Desativar é diferente de lixeira: quem saiu da empresa continua no histórico
  // de posse, só não opera mais — não entra no sistema e não recebe entrega
  // nova. Editável em `PUT /api/users/:id`, e a mudança vai para o ActivityLog
  // com ator e data.
  isActive Boolean @default(true)

  // O PAPEL (D148), no lugar da matriz de permissões por grupo (D76).
  //
  // `USUARIO` é o padrão e é o que a porta fechada da F3 pede: conta nova não
  // alcança nada além de si mesma, e quem quiser mais escreve a linha. A rede
  // que impede o sistema de ficar sem ninguém que entre está em
  // `access/helpers/ultimo-administrador.ts`, chamada no fim da transação.
  role             Papel              @default(USUARIO)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  assets           Asset[]
  managedLocations Location[]
  // Posses diretas (alvo USER) e postos de trabalho que esta pessoa ocupa.
  // Responsabilidade real = as duas somadas (docs/referencia/modelo-de-posse.md, Camada 3).
  assignments      Assignment[]
  occupancies      LocationOccupant[]

  // LICENÇA (F6). Assento vai para pessoa ou ativo, nunca para um posto (D39).
  licenseSeats LicenseSeatCheckout[]

  // ─────────────────────────────────────────────────────────────────────────
  // AS DUAS PERGUNTAS QUE PASSAM POR UMA PESSOA (D72).
  //
  //   quem RESPONDE pelo ativo?    a posse aberta → pessoa, ou os ocupantes do
  //                                 posto (`resolverResponsaveis`)
  //   quem responde pelo ESPAÇO?   `Location.managerId`
  //
  // Em uma linha: *o posto responde pelo ativo, e a pessoa responde pelo posto.*

  // `email` NÃO é @unique aqui de propósito: a unicidade é um índice parcial
  // (`WHERE deleted_at IS NULL`) criado na migration. Com @unique comum, um
  // usuário na lixeira bloquearia para sempre o recadastro do mesmo e-mail —
  // é o `unique_undeleted` do Snipe-IT (docs/ROADMAP.md, F2).
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     String
  changes    Json?
  actorId    String?  @db.Uuid
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}

// ============================================================================
// CATÁLOGO — as tabelas que o Snipe-IT chama de *Settings* (docs/historico/fase-01-catalogo-e-ativo.md)
//
// Nenhuma tem `deletedAt`, e isso é decisão, não esquecimento (D8): a extension
// de soft delete descobre a lixeira pela PRESENÇA da coluna, então a ausência é
// o opt-out. A proteção aqui é o 409 por uso — que é o que o Snipe-IT realmente
// faz ao recusar apagar categoria com item associado. Manter lixeira no catálogo
// custaria um índice único parcial por tabela, o `upsert` do seed e uma camada de
// apresentação para esconder relação apagada (a extension não alcança leitura
// aninhada — verificado).
// ============================================================================

enum CategoryType {
  ASSET
  LICENSE
}

// O tipo do status responde: *o que dá para fazer com este ativo agora?*
//
//   DEPLOYABLE   — está no estoque e pode ser entregue. O único que libera o
//                  checkout da F4.
//   IN_USE       — está com alguém ou instalado em algum lugar. Fora do estoque
//                  porque está CUMPRINDO a função dele.
//   PENDING      — fora do estoque por algum impedimento, e volta: em reparo,
//                  em diagnóstico, em trânsito, à espera de preparo.
//   UNDEPLOYABLE — ainda é patrimônio seu, mas não serve mais e não volta:
//                  danificado sem conserto, perdido, roubado.
//   ARCHIVED     — saiu da operação (vendido, descartado, doado). Sai das
//                  listagens do dia a dia.
//
// `IN_USE` é tipo PRÓPRIO, e não `PENDING`, porque a diferença entre "está com
// um colaborador" e "está na assistência" é a distinção mais cara do inventário:
// um está gerando valor, o outro está custando. Empacotar os dois em `PENDING`
// torna "quantos ativos estão em uso?" — a métrica principal do módulo —
// inexpressável pelo tipo.
//
// Também não é derivado de `assignedToId`: `statusId` é obrigatório no cadastro,
// a carga inicial é feita de equipamento que já está com gente, e existe uso SEM
// responsável (o monitor parafusado na sala de reunião).
//
// A ordem dos valores é a do ciclo de vida, e o Postgres a usa em `ORDER BY`
// sobre a coluna — por isso `IN_USE` entra DEPOIS de `DEPLOYABLE` na migration,
// e não no fim.
enum StatusLabelType {
  DEPLOYABLE
  IN_USE
  PENDING
  ARCHIVED
  UNDEPLOYABLE
}

// Por que o ativo saiu do patrimônio. Fechado de propósito: é campo de
// relatório contábil, e texto livre aqui vira "vendido", "Vendido" e "venda"
// na mesma coluna (D5).
enum RetiredReason {
  VENDIDO
  DESCARTADO
  DOADO
  EXTRAVIADO
  ROUBADO
  GARANTIA
}

model Category {
  id   String       @id @default(uuid()) @db.Uuid
  name String
  type CategoryType

  color String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assetModels AssetModel[]

  licenses License[]

  // Por (nome, tipo), não só por nome: "Notebook" como categoria de ATIVO e
  // "Notebook" como categoria de LICENÇA são duas coisas diferentes.
  @@unique([name, type])
  @@map("categories")
}

model StatusLabel {
  id   String          @id @default(uuid()) @db.Uuid
  name String          @unique
  type StatusLabelType

  color     String?
  showInNav Boolean @default(false)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]

  @@map("status_labels")
}

model Manufacturer {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  url          String?
  supportPhone String?
  supportEmail String?
  supportUrl   String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assetModels AssetModel[]

  licenses License[]

  @@map("manufacturers")
}

model AssetModel {
  id   String @id @default(uuid()) @db.Uuid
  name String

  modelNumber String?
  notes       String?

  manufacturerId String @db.Uuid
  categoryId     String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict é a rede embaixo do 409 do `countUsages`: mesmo que a checagem da
  // aplicação seja esquecida, o banco recusa e o P2003 vira 409 no errorHandler.
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  assets Asset[]

  // Vários modelos SEM número convivem: o Postgres trata NULL como distinto,
  // então não é preciso índice parcial aqui (verificado).
  @@unique([manufacturerId, modelNumber])
  @@index([categoryId])
  @@map("asset_models")
}

model Location {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  parentId String? @db.Uuid
  address  String?
  city     String?
  state    String?
  zip      String?
  phone    String?
  notes    String?

  // POSTO DE TRABALHO — a Mesa 1, a bancada, o guichê.
  //
  // O posto É uma `Location` (D15): a árvore já existe, o ativo já aponta para
  // ela, e criar uma `Workstation` paralela duplicaria a hierarquia. Mas uma
  // bancada NÃO é uma filial: endereço, CEP e telefone não querem dizer nada
  // numa mesa, e misturar as duas numa lista só foi o que tornou o posto
  // invisível na interface.
  //
  // Esta flag é de APRESENTAÇÃO, não de regra: ela separa as duas coisas nas
  // telas e habilita a página /postos. Nenhuma invariante depende dela — um
  // local sem a marca continua podendo receber ativo e ocupante, porque
  // proibir isso quebraria a sala de reunião que já funciona hoje.
  isWorkstation Boolean @default(false)

  // Gestor da localidade. SetNull de propósito: desligar o gestor não pode
  // derrubar a filial junto.
  managerId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // O banco NÃO impede ciclo (A→B→A foi aceito no teste): a guarda de ciclo é
  // da aplicação, em helpers/location-cycle.helper.ts.
  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Location[] @relation("LocationTree")
  manager  User?      @relation(fields: [managerId], references: [id], onDelete: SetNull)
  assets   Asset[]

  // Ativos entregues A ESTE LOCAL (alvo LOCATION) e as pessoas que o ocupam.
  // É a junção das duas que responde "quem é responsável pelo mouse da Mesa 1".
  assignments Assignment[]
  occupants   LocationOccupant[]

  // DECLARADOS AQUI, e não só na migration que os criou.
  //
  // Os dois nasceram à mão em `20260923102207_postos_descomissionamento_auth` e
  // ficaram de fora do schema. Consequência: o `migrate diff` não os via, achava
  // que eram lixo do banco e emitia `DROP INDEX` em TODA migração seguinte —
  // derrubando índice útil em silêncio para quem aplicasse o SQL sem ler.
  //
  // São índices COMUNS, que o Prisma expressa. Os PARCIAIS (`WHERE …`) continuam
  // só no SQL porque ele não os expressa, e esses o `migrate diff` ignora em vez
  // de tentar remover — a diferença é essa, e é o que separa "mora na migration
  // de propósito" de "ficou para trás".
  @@index([parentId])
  @@index([isWorkstation])
  @@map("locations")
}

// ============================================================================
// O ATIVO — o coração do ITAM (docs/historico/fase-01-catalogo-e-ativo.md, Etapa G)
// ============================================================================

// Um ativo = UM equipamento físico, com etiqueta e série próprias.
//
// Não existe `quantity` aqui, e é de propósito (D3): um ativo é UM equipamento.
// Contagem é consulta sobre linhas, não coluna.
//
// NÃO há `categoryId`: a categoria do ativo é a do MODELO (`model.category`) —
// é assim no Snipe-IT, e é o que impede um ativo e o seu modelo divergirem de
// categoria. Por isso `modelId` é obrigatório.
//
// NENHUMA coluna aqui pode se chamar `status`, `lastSeen` ou `hwid`: são os
// nomes do `Endpoint` (lado RMM), e é a ausência deles que faz o compilador
// barrar uma query do RMM que aponte para esta tabela (D13). Quando a F7 for
// registrar o último contato do agente, o campo chama `lastSeenByAgentAt`.
model Asset {
  id String @id @default(uuid()) @db.Uuid

  // Unicidade de `assetTag` e `serial` é índice PARCIAL (`WHERE deleted_at IS
  // NULL`), criado à mão na migration — NÃO `@unique`. Com unique comum, um
  // ativo na lixeira travaria para sempre o recadastro da mesma etiqueta. É o
  // `unique_undeleted` do Snipe-IT, o mesmo caso de `User.email` na Fase 0.
  assetTag String
  serial   String?

  name  String?
  notes String?

  byod        Boolean @default(false)
  requestable Boolean @default(false)

  statusId     String  @db.Uuid
  modelId      String  @db.Uuid
  // ONDE o ativo está. NÃO é quem responde por ele — ver `assignedToId` abaixo e
  // docs/referencia/modelo-de-posse.md: um ativo pode estar EM um lugar sem ser DO lugar (o
  // mouse reserva na gaveta de uma mesa ocupada).
  locationId   String? @db.Uuid
  // CACHE do caso `USER`, e só dele. A fonte de verdade da posse é a
  // `Assignment` aberta (docs/referencia/modelo-de-posse.md, Camada 1).
  //
  // Fica `null` quando o detentor é uma LOCALIZAÇÃO (a Mesa 1, cujos
  // responsáveis são os ocupantes dela) ou OUTRO ATIVO (a dock presa ao
  // notebook). Quem lê "quem responde por este ativo" chama
  // `resolverResponsaveis()`, nunca esta coluna sozinha.
  //
  // NÃO é editável pelo formulário de ativo — saiu do `createAssetSchema` e do
  // `updateAssetSchema` na F4. Escrevem aqui SÓ o checkout e o checkin: campo
  // editável à mão ao lado de uma tabela de posse são duas fontes de verdade
  // para o mesmo fato, e nada impede divergirem (D14).
  assignedToId String? @db.Uuid

  orderNumber  String?
  purchaseDate DateTime?
  // Decimal, nunca Float. Sai no JSON como string.
  purchaseCost Decimal?  @db.Decimal(12, 2)

  // DESCOMISSIONAMENTO — o ativo saiu do parque, e por quê.
  //
  // São TRÊS colunas diferentes e nenhuma substitui a outra (D19):
  //   `status.type = ARCHIVED` — saiu da operação, some das listagens do dia a dia
  //   `retiredAt`              — saiu do PATRIMÔNIO: vendido, descartado, roubado
  //   `deletedAt`              — foi cadastrado errado e está na lixeira
  // Um ativo vendido é um fato contábil e continua nos relatórios; um ativo na
  // lixeira é um erro de digitação e não deveria ter existido.
  retiredAt     DateTime?
  retiredReason RetiredReason?

  // QUEM cadastrou e QUEM editou por último.
  //
  // Duas colunas AQUI, e não nas catorze tabelas (D26): o `ActivityLog` já
  // responde "quem criou isto" — a linha `CREATE` está lá, com o ator. A coluna
  // existe para não fazer essa consulta POR LINHA na tela de detalhe do ativo,
  // que é a única que mostra o dado.
  //
  // SEM relação com `User`, pelo mesmo motivo do `ActivityLog.actorId`: se o
  // cadastro de quem criou o ativo for excluído, a autoria não pode virar
  // `SetNull` nem impedir a exclusão. É carimbo, não vínculo.
  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  status     StatusLabel @relation(fields: [statusId], references: [id], onDelete: Restrict)
  model      AssetModel  @relation(fields: [modelId], references: [id], onDelete: Restrict)
  location   Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedTo User?       @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  // A posse deste ativo, aberta e histórica.
  assignments     Assignment[] @relation("AssignmentAsset")
  // As posses em que este ativo é o DETENTOR (a dock que segura o notebook).
  heldAssignments Assignment[] @relation("AssignmentTargetAsset")

  // Os assentos de licença que esta máquina ocupa (F6).
  licenseSeats LicenseSeatCheckout[]

  // ── A CONVERGÊNCIA COM O RMM (F7) ────────────────────────────────────────
  //
  // `lastSeenByAgentAt`, e NUNCA `lastSeen` (D13). Se esta coluna se chamasse
  // `lastSeen`, o `markStaleEndpointsOffline` apontando para o model errado
  // COMPILARIA — e marcaria a frota inteira como OFFLINE em silêncio. Com o nome
  // diferente, o mesmo erro vira erro de compilação.
  //
  // QUEM ESCREVE É O JOB, não o handshake (D95). O `touchEndpoint` roda a cada
  // mensagem de cada máquina; um UPDATE condicional em `assets` ali seria
  // executado milhões de vezes por dia para quase nunca casar, e acoplaria a
  // tabela de patrimônio ao caminho de ingestão. A pergunta que esta coluna
  // responde — "não é visto há quantos dias?" — tolera uma hora de atraso.
  //
  // E ela EXISTE, em vez de ser derivada pelo `Endpoint`, porque a linha da
  // máquina descoberta pode sumir — apagá-la não pode zerar o histórico de "um
  // agente já viu este ativo".
  lastSeenByAgentAt DateTime?

  /// A máquina descoberta que É este ativo. Lado fraco do 1:1 — a FK mora lá (D45).
  endpoint Endpoint?

  changes   AssetChange[]
  usageDays AssetUsageDaily[]

  // `suggestions`, e não o `ReconciliationSuggestion` que o `prisma format`
  // escreveu sozinho: o nome gerado não é convenção nenhuma e destoa dos outros
  // três lados da mesma relação (`Endpoint`, `User` e `Location` todos a chamam
  // de `suggestions`). Nome de campo de relação não existe no banco, então isto
  // NÃO pede migração — o que ele muda é o que se lê no `include`.
  suggestions ReconciliationSuggestion[]

  @@index([deletedAt])
  @@index([statusId])
  @@index([modelId])
  @@index([locationId])
  @@index([assignedToId])
  // Ver a nota em `Location`: declarado aqui para o `migrate diff` parar de
  // emitir `DROP INDEX` dele a cada migração nova.
  @@index([retiredAt])
  @@index([lastSeenByAgentAt])
  @@map("assets")
}

// ============================================================================
// POSSE E RESPONSABILIDADE — docs/referencia/modelo-de-posse.md (D14, D15, D16)
// ============================================================================

// Para QUEM um ativo foi entregue.
//
// Polimórfico como no Snipe-IT — pessoa, outro ativo ou localização —, com uma
// diferença que o Snipe-IT não tem: quando o alvo é `LOCATION`, os responsáveis
// são os OCUPANTES daquele local, que podem ser vários e em turnos diferentes
// (`LocationOccupant`). É o que permite a Mesa 1 ser da Laura de manhã e da Ana
// à tarde sem o ativo precisar apontar para duas pessoas.
enum AssignmentTarget {
  USER
  ASSET
  LOCATION
}

// Uma linha por entrega. `checkinAt` nulo = posse ABERTA (a atual).
//
// O histórico NUNCA é apagado: a devolução preenche `checkinAt`, não deleta a
// linha. É o mesmo princípio do `ActivityLog`.
//
// UMA aberta por ativo, garantida por índice único PARCIAL criado na migration
// (`WHERE "checkinAt" IS NULL`) — regra do banco, não da aplicação, pelo mesmo
// motivo de `assets.assetTag`: o esquecimento deixa de ser possível.
//
// Esse índice é também a alavanca da decisão: o dia que N detentores simultâneos
// for necessário, derrubar o índice é a mudança — não reescrever a camada.
model Assignment {
  id      String @id @default(uuid()) @db.Uuid
  assetId String @db.Uuid

  // Discriminante + três FKs nuláveis. A coerência entre o tipo e qual FK está
  // preenchida é validada no use-case (`assertAlvoCoerente`): CHECK constraint
  // não é expressável no schema do Prisma e ficaria invisível aqui.
  targetType       AssignmentTarget
  targetUserId     String?          @db.Uuid
  targetAssetId    String?          @db.Uuid
  targetLocationId String?          @db.Uuid

  checkoutAt        DateTime  @default(now())
  expectedCheckinAt DateTime?
  checkinAt         DateTime?

  checkoutNotes String?
  checkinNotes  String?

  // Quem operou a entrega e a devolução. Nulável e SEM relação com `User` pelo
  // mesmo motivo do `ActivityLog.actorId`: autenticação é a F3, e esperar por
  // ela significaria perder o registro de tudo que rodar até lá.
  checkoutById String? @db.Uuid
  checkinById  String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade no ativo dono da posse: apagar o ativo de verdade leva o histórico
  // dele junto. Restrict nos ALVOS: não se apaga uma pessoa, um local ou um
  // ativo que ainda segura alguma coisa — é o 409 por uso do catálogo.
  asset          Asset     @relation("AssignmentAsset", fields: [assetId], references: [id], onDelete: Cascade)
  targetUser     User?     @relation(fields: [targetUserId], references: [id], onDelete: Restrict)
  targetAsset    Asset?    @relation("AssignmentTargetAsset", fields: [targetAssetId], references: [id], onDelete: Restrict)
  targetLocation Location? @relation(fields: [targetLocationId], references: [id], onDelete: Restrict)

  @@index([assetId, checkinAt])
  @@index([targetUserId, checkinAt])
  @@index([targetLocationId, checkinAt])
  @@index([targetAssetId, checkinAt])
  @@map("assignments")
}

model LocationOccupant {
  id         String @id @default(uuid()) @db.Uuid
  locationId String @db.Uuid
  userId     String @db.Uuid

  // Texto livre de propósito: "Manhã", "Tarde", "12x36 A". Enum engessaria
  // escalas reais e faixa de horário seria agenda, não inventário (D15).
  shift String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  // A mesma pessoa não ocupa o mesmo posto duas vezes ao mesmo tempo: índice
  // único PARCIAL (`WHERE "endedAt" IS NULL`) criado na migration.
  @@index([locationId, endedAt])
  @@index([userId, endedAt])
  @@map("location_occupants")
}

model JobRun {
  /// O nome do job — hoje só 'reconciliacao'.
  name      String    @id
  lastRunAt DateTime?
  updatedAt DateTime  @updatedAt

  @@map("job_runs")
}

model AppSetting {
  id String @id @default("singleton")

  // Etiqueta automática: ATV- + 00001. `assetTagNext` é incrementado PRIMEIRO e
  // o valor devolvido é o que vira etiqueta — ler-e-depois-incrementar colide
  // em READ COMMITTED.
  assetTagPrefix   String @default("ATV-")
  assetTagZerofill Int    @default(5)
  assetTagNext     Int    @default(1)

  // QUAL rótulo a entrega e a devolução aplicam.
  //
  // Vazios, vale o comportamento que já existia: o PRIMEIRO status do tipo
  // (`IN_USE` na entrega, `DEPLOYABLE` na devolução), ordenado por nome. Isso
  // funciona com os 8 rótulos do seed e vira loteria quando alguém cadastra
  // "Em uso — home office" e "Em uso — escritório": a escolha passa a depender
  // da ordem alfabética, e ninguém escreveu isso em lugar nenhum.
  checkoutStatusId String? @db.Uuid
  checkinStatusId  String? @db.Uuid

  // ── OS BOTÕES DA DESCOBERTA (F7) ─────────────────────────────────────────
  //
  // Moram no singleton que já existe, e não numa tabela de configuração nova:
  // são três valores, não um domínio.
  //
  // `SUGGEST` é o padrão e isso é o D51: em `ON`, a primeira VM de teste que
  // alguém subir vira patrimônio — e consome uma etiqueta do contador, que o
  // `nextAssetTag()` nunca devolve. O estrago não é a linha a mais, é a
  // sequência de etiquetas furada para sempre.
  discoveryMode DiscoveryMode @default(SUGGEST)

  /// Ativo sem contato de agente há mais que isto é FANTASMA.
  ghostDays   Int @default(30)
  /// Máquina sem cadastro vista há mais que isto é SHADOW IT.
  shadowHours Int @default(24)

  // ── O FORMATO (F10, D65) ─────────────────────────────────────────────────
  //
  // MORA NO BANCO e não no `.env`: moeda e formato de data mudam sem deploy. O
  // que fica no ambiente é o que é SEGREDO ou é do processo.

  /// Como NÚMERO e DATA são escritos na tela.
  locale     String @default("pt-BR")
  dateFormat String @default("DD/MM/YYYY")
  currency   String @default("BRL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ============================================================================
// LICENÇAS DE SOFTWARE — docs/historico/fase-06-licencas.md (D39–D94)
//
// O que a licença tem e o ativo não tem é ASSENTO: ela não é entregue, é
// consumida N vezes. Três decisões desenham as tabelas:
//
//   D40  o assento é MATERIALIZADO (uma linha, não um contador) — é o que se trava
//   D39  o assento vai para uma pessoa XOR um ativo, nunca para um posto
//
// Nenhuma coluna de saldo (livres é conta sobre as linhas, D92) e nenhuma
// coluna de status (é função das datas e de hoje, D44).
// ============================================================================

model License {
  // SEM `@default(uuid())`: o id vem da aplicação (create-license.usecase.ts).
  id   String @id @db.Uuid
  name String

  /// Assentos do contrato hoje. Invariante 11: COUNT(assentos sem retiredAt) = este número.
  seatsTotal Int

  /// `false` = assento devolvido QUEIMA e não volta ao contrato (D43).
  reassignable Boolean @default(true)
  /// Contrato de manutenção. Informativo e filtro — não tem efeito no inventário.
  maintained   Boolean @default(false)

  expirationDate  DateTime?
  /// Rescisão. Vence tudo: JÁ PASSADA, a licença é ENCERRADA mesmo com
  /// vencimento futuro. Data FUTURA ainda não encerra nada — o contrato vale
  /// até o dia marcado (`license-status.helper.ts` compara com hoje).
  terminationDate DateTime?

  licensedToName  String?
  licensedToEmail String?

  /// Piso do alerta de assentos livres. Nulo = não alerta.
  minSeats Int?

  categoryId     String  @db.Uuid
  manufacturerId String? @db.Uuid

  orderNumber  String?
  purchaseDate DateTime?
  /// Decimal, nunca Float. Sai no JSON como STRING.
  purchaseCost Decimal?  @db.Decimal(12, 2)

  notes String?

  // Autoria (D26): sem FK, como em `Asset`.
  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)

  seats LicenseSeat[]

  // `name` não é @unique: a unicidade é índice PARCIAL na migration.
  @@index([deletedAt])
  @@index([categoryId])
  @@index([expirationDate])
  @@map("licenses")
}

// Uma linha por assento comprado — a unidade contável e travável (D40).
//
// NÃO tem `deletedAt`: a `softDeleteExtension` escopa todo model que tenha a
// coluna, e com lixeira o saldo pararia de enxergar ocupação aberta. Assento se
// aposenta, não some.
model LicenseSeat {
  id        String @id @default(uuid()) @db.Uuid
  licenseId String @db.Uuid

  /// Único por licença. Assento novo nasce com MAX+1, nunca COUNT+1 — a linha
  /// aposentada continua na tabela e a contagem colidiria.
  seatNumber Int

  /// QUEIMADO: devolvido numa licença não reatribuível. Perda de dinheiro.
  burnedAt  DateTime?
  /// APOSENTADO: o contrato encolheu. Mudança de contrato — relatório diferente (D43).
  retiredAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  license   License               @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  checkouts LicenseSeatCheckout[]

  @@unique([licenseId, seatNumber], map: "license_seats_numero")
  @@index([licenseId])
  @@map("license_seats")
}

// A ocupação. Devolver preenche `checkinAt` e NUNCA apaga a linha — mesmo
// princípio do `Assignment` (D40).
model LicenseSeatCheckout {
  id     String @id @default(uuid()) @db.Uuid
  seatId String @db.Uuid

  // XOR garantido por CHECK na migration (`license_seat_alvo_xor`). Sem
  // discriminante: com dois alvos, a FK preenchida já diz qual é.
  assignedUserId  String? @db.Uuid
  assignedAssetId String? @db.Uuid

  checkoutAt DateTime  @default(now())
  /// Nulo = assento OCUPADO. É o que a conta de livres desconta.
  checkinAt  DateTime?

  checkoutNotes String?
  checkinNotes  String?

  checkoutById String? @db.Uuid
  checkinById  String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade no assento; Restrict nos alvos — é a rede embaixo do 409 que
  // impede apagar pessoa ou ativo que ainda ocupa assento.
  seat          LicenseSeat @relation(fields: [seatId], references: [id], onDelete: Cascade)
  assignedUser  User?       @relation(fields: [assignedUserId], references: [id], onDelete: Restrict)
  assignedAsset Asset?      @relation(fields: [assignedAssetId], references: [id], onDelete: Restrict)

  @@index([seatId, checkinAt])
  @@index([assignedUserId, checkinAt])
  @@index([assignedAssetId, checkinAt])
  @@map("license_seat_checkouts")
}

// ============================================================================
// CONVERGÊNCIA RMM × ITAM — docs/historico/fase-07-convergencia-rmm-itam.md (D45–D51, D95–D103)
//
// O `Endpoint` sabe o que a máquina É; o `Asset` sabe o que a empresa COMPROU e
// de quem cobra. Tudo aqui existe para ligar os dois SEM FUNDI-LOS (D45) e para
// transformar o que o agente OBSERVA em cadastro que uma pessoa CONFIRMA.
//
// A regra que atravessa a fase inteira: nada aqui escreve posse sozinho. A fila
// propõe, um humano aceita, e quem grava é o use-case da F4 — com o zod da
// borda, o ActivityLog e as invariantes 1, 2 e 4 que já existem.
// ============================================================================

/// O que o sistema faz quando descobre máquina sem cadastro. `SUGGEST` por
/// padrão, e o porquê está no D51.
enum DiscoveryMode {
  OFF
  SUGGEST
  ON
}

/// POR QUE o sistema acha que este endpoint é este ativo. O ponto de cada um
/// está em `helpers/match-cascade.helper.ts`, não aqui: pontuação é regra de
/// negócio e muda; o nome do sinal é o vocabulário e não muda.
enum MatchSignal {
  SERIAL
  UUID
  HOSTNAME
}

/// O QUE a sugestão propõe. Um valor só hoje, e o enum fica: a fila é construída
/// em volta do que dá trabalho (nascer de um job idempotente, não duplicar,
/// guardar evidência, ser aceita ou recusada, lembrar da recusa), e isso não
/// depende de quantas formas existem.
enum SuggestionKind {
  /// Este endpoint é este ativo.
  LINK
}

enum SuggestionState {
  PENDING
  ACCEPTED
  REJECTED
  /// A evidência mudou e esta sugestão foi substituída por outra. Não é recusa:
  /// ninguém disse não, o mundo é que mudou.
  SUPERSEDED
}

// A FILA DE RECONCILIAÇÃO — uma tabela, e não uma por forma de sugestão (D96).
//
// POR QUE UMA SÓ: o que é caro é a fila (idempotência, deduplicação, evidência,
// aceite, memória da recusa), e uma tabela por forma seria uma cópia dessa
// máquina para variar o que é barato — qual é o alvo. Invariante copiada é
// invariante que um dia diverge.
//
// O `kind` continua existindo com um valor só porque é a fila que carrega o
// desenho, não a contagem de formas: o dia que nascer a segunda, ela entra aqui
// sem tabela nova.
model ReconciliationSuggestion {
  id   String         @id @default(uuid()) @db.Uuid
  kind SuggestionKind

  endpointId String @db.Uuid

  /// O alvo: o ativo que esta máquina É.
  assetId String? @db.Uuid

  /// 0 a 100, e todo ponto vem de sinal de hardware: é a cascata de identidade
  /// que pontua, não um palpite sobre gente.
  score  Int
  signal MatchSignal?

  /// O QUE o sistema viu — qual sinal casou, com que valor, em que hostname.
  /// Vai para a tela: sugestão sem evidência visível é palpite, e ninguém
  /// deveria aceitar um palpite que reescreve o inventário.
  evidence Json

  /// sha256 da evidência normalizada. É o que separa "já me disseram não sobre
  /// ISTO" de "já me disseram não sobre este par, faça o que fizer" (D97).
  evidenceHash String

  state        SuggestionState @default(PENDING)
  resolvedAt   DateTime?
  /// Sem FK, como `ActivityLog.actorId`: é carimbo de quem decidiu, não vínculo.
  resolvedById String?         @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  endpoint Endpoint @relation("SugestaoDoEndpoint", fields: [endpointId], references: [id], onDelete: Cascade)
  asset    Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // O índice que impede a fila de empilhar (`sugestao_pendente_por_alvo`, com
  // COALESCE na FK nulável) é PARCIAL e nasce na migration escrita à mão.
  @@index([state, kind])
  @@index([endpointId, state])
  @@index([assetId])
  @@map("reconciliation_suggestions")
}

// MUDANÇA DE HARDWARE DETECTADA — trocou o HD, tiraram pente de RAM.
//
// Detectada, não digitada: a diferença com o `ActivityLog` é essa. Lá a linha
// tem ator e diz o que alguém FEZ; aqui não tem ator nenhum e diz o que o mundo
// mudou sem avisar. Espremer isto no ActivityLog daria `actorId` nulo em toda
// linha — e o D23 existe justamente para que ator nulo signifique alguma coisa.
model AssetChange {
  id         String  @id @default(uuid()) @db.Uuid
  assetId    String  @db.Uuid
  endpointId String? @db.Uuid

  /// O nome do campo como o usuário o vê: "RAM total", "Disco", "Modelo".
  field    String
  oldValue String?
  newValue String

  detectedAt DateTime @default(now())

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  endpoint Endpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([assetId, detectedAt])
  @@map("asset_changes")
}

// ATIVO OCIOSO — quanto a máquina foi realmente usada, agregado por dia.
//
// Mesmo motivo do D49: sem agregação, "quem não usa este notebook há 30 dias"
// varre milhões de linhas de telemetria. E cruzado com o `postoVago` que o
// `resolverResponsaveis()` já devolve, isto separa "ninguém USA" de "ninguém
// RESPONDE" — duas conversas diferentes, com duas pessoas diferentes.
model AssetUsageDaily {
  id      String   @id @default(uuid()) @db.Uuid
  assetId String   @db.Uuid
  day     DateTime @db.Date

  /// Minutos com sinal de uso no dia, estimados pelas amostras de telemetria.
  activeMinutes Int @default(0)
  samples       Int @default(0)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, day])
  @@index([assetId, day])
  @@map("asset_usage_daily")
}
