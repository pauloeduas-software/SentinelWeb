# Modelo do .env do projeto. Copie para `.env` e ajuste:
#   cp .env.example .env
#
# O servidor valida estas variáveis no boot (server/core/config/env.ts): faltando
# o que é obrigatório, ele não sobe — com a lista do que falta, em vez de falhar
# na primeira requisição.

# --- Portas dos serviços ---
# Front (Vite) e back (Fastify) são lidos também pelo vite.config.ts, que usa a
# porta do back para fazer proxy de /api e /agent-hub em desenvolvimento.
FRONT_PORT=3000
PORT=3001
POSTGRES_PORT=3002

# --- Banco (obrigatório) ---
# A porta aqui precisa ser a mesma de POSTGRES_PORT.
# Prisma não expande ${VAR} dentro do .env, por isso o valor é literal.
DATABASE_URL="postgresql://sentinel:sentinelpassword@localhost:3002/sentineldb?schema=public"

# --- Agente Sentinel (obrigatório em produção) ---
# Segredo compartilhado com o agente C#. Ele envia em
# `Authorization: Bearer <token>` ao abrir o WebSocket do /agent-hub.
#
# Sem esta variável o hub aceita QUALQUER WebSocket: em produção o servidor se
# recusa a subir; em desenvolvimento ele sobe com aviso no log.
#
# Gere um valor forte:  openssl rand -hex 32
AGENT_TOKEN=

# --- Opcionais ---
# Nível do log estruturado: debug | info | warn | error (padrão: info).
# Em produção o log sai em JSON, uma linha por evento, com X-Request-Id.
LOG_LEVEL=info

# Origem do frontend, quando ele NÃO for servido pelo mesmo host da API.
# Vazio é o normal: em dev o Vite faz proxy e em produção o Fastify serve o
# painel — nos dois casos é mesma origem e não há CORS a liberar.
# Aceita várias separadas por vírgula. `*` é recusado no boot.
# CORS_ORIGIN=https://painel.suaempresa.com

# `production` faz o Fastify servir o ./dist e liga o log em JSON.
# Não defina em desenvolvimento.
# NODE_ENV=production
