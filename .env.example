# Modelo do .env do projeto. Copie para `.env` e ajuste:
#   cp .env.example .env
#
# O servidor valida estas variáveis no boot (server/core/config/env.ts): faltando
# o que é obrigatório, ele não sobe — com a lista do que falta, em vez de falhar
# na primeira requisição.

# --- Portas dos serviços ---
# Front (Vite) e back (Fastify) são lidos também pelo vite.config.ts, que usa a
# porta do back para fazer proxy de /api e /agent-hub em desenvolvimento.
FRONT_PORT=3000
PORT=3001
POSTGRES_PORT=3002

# --- Banco (obrigatório) ---
# A porta aqui precisa ser a mesma de POSTGRES_PORT.
# Prisma não expande ${VAR} dentro do .env, por isso o valor é literal.
DATABASE_URL="postgresql://sentinel:sentinelpassword@localhost:3002/sentineldb?schema=public"

# --- Sessão (obrigatório) ---
# Chave que assina o JWT guardado no cookie httpOnly da sessão (F3, D22).
#
# Sem ela o servidor NÃO sobe: segredo ausente não pode virar "assina com string
# vazia", que é sessão forjável por qualquer um. Segredo curto ou começando por
# um valor de exemplo ("changeme", "secret"...) derruba o boot em produção e sai
# como aviso em desenvolvimento.
#
# Trocar o valor invalida todas as sessões abertas — é o botão de "derrubar todo
# mundo" quando se suspeita de vazamento.
#
# Gere um valor forte:  openssl rand -hex 32
JWT_SECRET=

# --- Administrador inicial (seed) ---
# Senha do administrador que `npm run db:seed` cria para o banco poder ser
# usado: com a API fechada por padrão, sem esta conta ninguém entra para criar
# a primeira.
#
# Vazio: em desenvolvimento o seed usa uma senha padrão e AVISA no log; em
# produção ele se recusa a criar a conta. Rodar o seed de novo NÃO reescreve a
# senha de um administrador que já existe.
#
# ADMIN_USERNAME (padrão: admin) e ADMIN_EMAIL (padrão: admin@sentinel.local)
# também podem ser ajustados.
ADMIN_PASSWORD=

# --- Agente Sentinel (obrigatório em produção) ---
# Segredo compartilhado com o agente C#. Ele envia em
# `Authorization: Bearer <token>` ao abrir o WebSocket do /agent-hub.
#
# Sem esta variável o hub aceita QUALQUER WebSocket: em produção o servidor se
# recusa a subir; em desenvolvimento ele sobe com aviso no log.
#
# Gere um valor forte:  openssl rand -hex 32
AGENT_TOKEN=

# --- Correio (opcional) ---
# Sem SMTP_URL o correio roda em modo NO-OP: ele registra no log o e-mail que
# teria mandado, com destinatário e assunto. Não é omissão — silêncio torna
# "não chegou" indepurável, e em desenvolvimento ninguém quer um servidor SMTP.
#
# Formato do nodemailer:
#   smtp://usuario:senha@smtp.empresa.com:587
#   smtps://usuario:senha@smtp.empresa.com:465
# SMTP_URL=

# Remetente. Padrão: "Sentinel <nao-responda@sentinel.local>".
# MAIL_FROM="Sentinel TI <ti@suaempresa.com>"

# URL pública do painel, usada nos LINKS do corpo do e-mail. Padrão:
# http://localhost:3000. Um valor errado aqui manda todo mundo para lugar
# nenhum — e ele aparece inteiro no log do modo no-op, antes de ir a produção.
# APP_URL=https://painel.suaempresa.com

# --- Arquivos (opcional) ---
# Onde ficam os anexos e as imagens. Padrão: ./uploads (relativo ao processo).
#
# APONTE PARA FORA DO REPOSITÓRIO em produção: dentro dele, um `git clean` ou um
# rebuild apaga nota fiscal e contrato. E este diretório é a SEGUNDA metade do
# backup — o `pg_dump` sozinho não leva os arquivos.
#
# Ele NÃO é servido como estático: os arquivos saem por rotas /api/ que exigem
# sessão (docs/FECHAMENTO-F2-F4-PLANO-ITAM.md, D84). Não o coloque dentro de
# ./dist nem de qualquer raiz pública.
# UPLOAD_DIR=/var/lib/sentinel/uploads

# --- Opcionais ---
# Nível do log estruturado: debug | info | warn | error (padrão: info).
# Em produção o log sai em JSON, uma linha por evento, com X-Request-Id.
LOG_LEVEL=info

# Origem do frontend, quando ele NÃO for servido pelo mesmo host da API.
# Vazio é o normal: em dev o Vite faz proxy e em produção o Fastify serve o
# painel — nos dois casos é mesma origem e não há CORS a liberar.
# Aceita várias separadas por vírgula. `*` é recusado no boot.
# CORS_ORIGIN=https://painel.suaempresa.com

# `production` faz o Fastify servir o ./dist e liga o log em JSON.
# Não defina em desenvolvimento.
# NODE_ENV=production
