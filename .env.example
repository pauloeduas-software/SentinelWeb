# Copie para `.env` e preencha o que está marcado como obrigatório:
#   cp .env.example .env

# --- Portas ---
FRONT_PORT=3000
PORT=3001
POSTGRES_PORT=3002

# --- Obrigatórias ---
# Sem estas o servidor não sobe. A porta precisa ser a mesma de POSTGRES_PORT.
DATABASE_URL="postgresql://sentinel:sentinelpassword@localhost:3002/sentineldb?schema=public"

# Assina o cookie de sessão. Gere com: openssl rand -hex 32
# Trocar o valor derruba todas as sessões abertas.
JWT_SECRET=

# --- Obrigatórias em produção ---
# Segredo compartilhado com o agente C#. Gere com: openssl rand -hex 32
AGENT_TOKEN=

# Cifra a chave de produto das licenças em repouso (AES-256-GCM).
# Gere com: openssl rand -hex 32
#
# Sem ela o sistema sobe, mas o campo de chave de produto responde 422 — nada
# é gravado em claro. Em produção o boot PARA sem ela.
#
# TROCAR O VALOR torna ilegível toda chave já gravada, e o canário derruba o
# boot dizendo isso. Para rotacionar, ponha a chave ANTIGA na linha de baixo:
# a nova passa a cifrar e a antiga continua decifrando o que já existe.
#
# A antiga só pode SAIR daqui depois que todo valor cifrado com ela tiver sido
# recifrado — o canário se regrava com a chave ativa no primeiro boot da
# rotação, então ele deixa de acusar a falta dela.
APP_ENCRYPTION_KEY=
# APP_ENCRYPTION_KEYS_ANTIGAS=chave1,chave2

# --- Opcionais ---
# Senha do administrador criado pelo `npm run db:seed`.
ADMIN_PASSWORD=

# Onde ficam anexos e imagens. Padrão: ./uploads
# Em produção, aponte para fora do repositório.
# UPLOAD_DIR=/var/lib/sentinel/uploads

# Correio. Sem SMTP_URL, o envio só é registrado no log.
# SMTP_URL=smtp://usuario:senha@smtp.empresa.com:587
# MAIL_FROM="Sentinel TI <ti@suaempresa.com>"
# APP_URL=https://painel.suaempresa.com

# Origem do frontend, quando ele não for servido pela API. `*` é recusado.
# CORS_ORIGIN=https://painel.suaempresa.com

# debug | info | warn | error
LOG_LEVEL=info

# NODE_ENV=production
