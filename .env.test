# Ambiente do harness de teste. Versionado: não há segredo aqui e o banco é
# descartável. Quem clonar o repositório roda `npm test` sem configurar nada.
# Detalhes em docs/TESTES.md.

# O harness ESVAZIA este banco. O nome precisa terminar em `_test`.
DATABASE_URL="postgresql://sentinel:sentinelpassword@localhost:3002/sentineldb_test?schema=public"

JWT_SECRET=harness-vitest-sentinel-0123456789abcdef
ADMIN_PASSWORD=harness-vitest-admin
AGENT_TOKEN=harness-vitest-agent-token

# Necessária: sem ela toda origem é aceita e o teste anti-CSRF não prova nada.
CORS_ORIGIN="http://localhost:3000"

LOG_LEVEL=error
